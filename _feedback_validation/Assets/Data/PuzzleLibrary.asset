--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd75731c030ad0744833a8cea870e6a4, type: 3}
  m_Name: PuzzleLibrary
  m_EditorClassIdentifier: Assembly-CSharp::Erudition.PuzzleLibrary
  entries:
  - id: c_pushkin_01
    mode: 0
    text: "\u041B\u044E\u0431\u0432\u0438 \u0432\u0441\u0435 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u044B
      \u043F\u043E\u043A\u043E\u0440\u043D\u044B."
    source: "\u0410. \u0421. \u041F\u0443\u0448\u043A\u0438\u043D"
    minimumErudition: 0
    authorIndex: 0
    themeIndex: 1
    bookIndex: 0
  - id: c_tolstoy_01
    mode: 0
    text: "\u0412\u0441\u0435 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0435
      \u0441\u0435\u043C\u044C\u0438 \u043F\u043E\u0445\u043E\u0436\u0438 \u0434\u0440\u0443\u0433
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0430."
    source: "\u041B. \u041D. \u0422\u043E\u043B\u0441\u0442\u043E\u0439"
    minimumErudition: 0
    authorIndex: 1
    themeIndex: 1
    bookIndex: 1
  - id: c_dostoevsky_01
    mode: 0
    text: "\u041A\u0440\u0430\u0441\u043E\u0442\u0430 \u0441\u043F\u0430\u0441\u0451\u0442
      \u043C\u0438\u0440."
    source: "\u0424. \u041C. \u0414\u043E\u0441\u0442\u043E\u0435\u0432\u0441\u043A\u0438\u0439"
    minimumErudition: 0
    authorIndex: 2
    themeIndex: 2
    bookIndex: 1
  - id: c_chekhov_01
    mode: 0
    text: "\u0412 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0435 \u0432\u0441\u0451
      \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E."
    source: "\u0410. \u041F. \u0427\u0435\u0445\u043E\u0432"
    minimumErudition: 100
    authorIndex: 3
    themeIndex: 2
    bookIndex: 1
  - id: c_gogol_01
    mode: 0
    text: "\u0420\u0443\u0441\u044C, \u043A\u0443\u0434\u0430 \u0436 \u043D\u0435\u0441\u0451\u0448\u044C\u0441\u044F
      \u0442\u044B?"
    source: "\u041D. \u0412. \u0413\u043E\u0433\u043E\u043B\u044C"
    minimumErudition: 100
    authorIndex: 4
    themeIndex: 0
    bookIndex: 2
  - id: c_turgenev_01
    mode: 0
    text: "\u0423\u0442\u0440\u043E \u0442\u0443\u043C\u0430\u043D\u043D\u043E\u0435,
      \u0443\u0442\u0440\u043E \u0441\u0435\u0434\u043E\u0435."
    source: "\u0418. \u0421. \u0422\u0443\u0440\u0433\u0435\u043D\u0435\u0432"
    minimumErudition: 100
    authorIndex: 5
    themeIndex: 0
    bookIndex: 0
  - id: c_original_01
    mode: 0
    text: "\u0427\u0442\u0435\u043D\u0438\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043D\u043E\u0432\u044B\u0435 \u0434\u043E\u0440\u043E\u0433\u0438 \u0434\u043B\u044F
      \u043C\u044B\u0441\u043B\u0438."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 180
    authorIndex: -1
    themeIndex: 2
    bookIndex: 0
  - id: c_original_02
    mode: 0
    text: "\u0414\u043E\u0431\u0440\u0430\u044F \u043C\u044B\u0441\u043B\u044C \u043E\u0441\u0432\u0435\u0449\u0430\u0435\u0442
      \u0441\u0430\u043C\u044B\u0439 \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u044C."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 180
    authorIndex: -1
    themeIndex: 2
    bookIndex: 2
  - id: c_original_03
    mode: 0
    text: "\u0421\u043B\u043E\u0432\u043E \u043F\u0438\u0448\u0435\u0442\u0441\u044F
      \u043F\u0435\u0440\u043E\u043C, \u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0432 \u043F\u0430\u043C\u044F\u0442\u0438."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 260
    authorIndex: -1
    themeIndex: 2
    bookIndex: 1
  - id: c_original_04
    mode: 0
    text: "\u0412 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u043D\u0438\u0433\u0435
      \u0436\u0438\u0432\u0451\u0442 \u0446\u0435\u043B\u044B\u0439 \u043D\u0435\u0438\u0437\u0432\u0435\u0434\u0430\u043D\u043D\u044B\u0439
      \u043C\u0438\u0440."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 260
    authorIndex: -1
    themeIndex: 2
    bookIndex: 2
  - id: c_original_05
    mode: 0
    text: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u0447\u0438\u0442\u0441\u044F,
      \u043F\u043E\u043A\u0430 \u0438\u0449\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u044B
      \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u044B."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 350
    authorIndex: -1
    themeIndex: 2
    bookIndex: 1
  - id: c_original_06
    mode: 0
    text: "\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u0447\u0438\u0442\u0430\u0435\u043C,
      \u043D\u0430\u0448 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
      \u043C\u0438\u0440 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0431\u043E\u0433\u0430\u0447\u0435."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 350
    authorIndex: -1
    themeIndex: 2
    bookIndex: 0
  - id: t_01
    mode: 1
    text: "\u0417\u043D\u0430\u043D\u0438\u0435 \u2014 \u0441\u0438\u043B\u0430."
    source: "\u041D\u0430\u0440\u043E\u0434\u043D\u0430\u044F \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C"
    minimumErudition: 0
    authorIndex: -1
    themeIndex: 2
    bookIndex: 1
  - id: t_02
    mode: 1
    text: "\u041A\u043D\u0438\u0433\u0430 \u2014 \u0434\u0440\u0443\u0433."
    source: "\u041D\u0430\u0440\u043E\u0434\u043D\u0430\u044F \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C"
    minimumErudition: 0
    authorIndex: -1
    themeIndex: 2
    bookIndex: 0
  - id: t_03
    mode: 1
    text: "\u0421\u043C\u0435\u043B\u043E \u0434\u0443\u043C\u0430\u0439."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 0
    authorIndex: -1
    themeIndex: 2
    bookIndex: 1
  - id: t_04
    mode: 1
    text: "\u0421\u043B\u043E\u0432\u043E \u043B\u0435\u0447\u0438\u0442."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 100
    authorIndex: -1
    themeIndex: 1
    bookIndex: 0
  - id: t_05
    mode: 1
    text: "\u0412\u0435\u043A \u0436\u0438\u0432\u0438 \u2014 \u0432\u0435\u043A
      \u0443\u0447\u0438\u0441\u044C."
    source: "\u041D\u0430\u0440\u043E\u0434\u043D\u0430\u044F \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C"
    minimumErudition: 100
    authorIndex: -1
    themeIndex: 2
    bookIndex: 1
  - id: t_06
    mode: 1
    text: "\u041C\u0435\u0447\u0442\u0430\u0439 \u0438 \u0447\u0438\u0442\u0430\u0439."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 100
    authorIndex: -1
    themeIndex: 1
    bookIndex: 2
  - id: t_07
    mode: 1
    text: "\u0418\u0449\u0438 \u0441\u0432\u043E\u0439 \u043E\u0442\u0432\u0435\u0442."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 180
    authorIndex: -1
    themeIndex: 2
    bookIndex: 1
  - id: t_08
    mode: 1
    text: "\u041C\u044B\u0441\u043B\u0438 \u0448\u0438\u0440\u0435."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 180
    authorIndex: -1
    themeIndex: 2
    bookIndex: 1
  - id: t_09
    mode: 1
    text: "\u0414\u043E\u0431\u0440\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 260
    authorIndex: -1
    themeIndex: 1
    bookIndex: 2
  - id: t_10
    mode: 1
    text: "\u0412 \u0441\u043B\u043E\u0432\u0430\u0445 \u0435\u0441\u0442\u044C \u0441\u0438\u043B\u0430."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 260
    authorIndex: -1
    themeIndex: 2
    bookIndex: 0
  - id: t_11
    mode: 1
    text: "\u0427\u0438\u0442\u0430\u0439 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 350
    authorIndex: -1
    themeIndex: 2
    bookIndex: 0
  - id: t_12
    mode: 1
    text: "\u0423\u043C \u0440\u0430\u0441\u0442\u0451\u0442 \u043E\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432."
    source: "\u042D\u0440\u0443\u0434\u0438\u0446\u0438\u044F"
    minimumErudition: 350
    authorIndex: -1
    themeIndex: 2
    bookIndex: 1
