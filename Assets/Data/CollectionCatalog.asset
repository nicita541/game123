      answer: 
    - id: level_v4_c01_t0_n09
      text: "\u0421\u0442\u0430\u0440\u0430\u044F \u0441\u0442\u0440\u043E\u043A\u0430
        \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043E\u0431
        \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0438 \u043A \u043B\u044E\u0434\u044F\u043C."
      source: "\u041F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
