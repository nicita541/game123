    - id: level_v4_c08_t0_n01
      text: "\u041F\u0430\u0443\u0437\u0430 \u0438\u043D\u043E\u0433\u0434\u0430
        \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0442\u043E\u0447\u043D\u0435\u0435
        \u043F\u043E\u043D\u044F\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
