    - id: level_v4_c09_t0_n06
      text: "\u041A\u043E\u0440\u043E\u0442\u043A\u043E\u0435 \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435
