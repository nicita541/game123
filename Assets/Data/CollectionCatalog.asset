      kind: 2
      minimumErudition: 0
      answer: ""
    - id: level_v2_c14_t0_n05
      text: "Полезное знание ценится делом."
      source: "Пословицы Совушки"
      kind: 2
      minimumErudition: 0
      answer: ""
    - id: level_v2_c14_t0_n06
      text: "Спокойный ум ценится делом."
