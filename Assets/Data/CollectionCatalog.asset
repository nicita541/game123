      kind: 1
      minimumErudition: 0
      answer: ""
    - id: level_v2_c11_t0_n04
      text: "Учитель нашёл тайную дверь."
      source: "Подборка «Сказки»"
      kind: 1
      minimumErudition: 0
      answer: ""
    - id: level_v2_c11_t0_n05
      text: "Мастер нашёл старое обещание."
      source: "Подборка «Сказки»"
      kind: 1
      minimumErudition: 0
      answer: ""
    - id: level_v2_c11_t0_n06
      text: "Фотограф нашёл заколдованный сад."
      source: "Подборка «Сказки»"
      kind: 1
      minimumErudition: 0
      answer: ""
    - id: level_v2_c11_t0_n07
      text: "Садовник нашёл честную награду."
      source: "Подборка «Сказки»"
      kind: 1
      minimumErudition: 0
      answer: ""
    - id: level_v2_c11_t0_n08
      text: "Студент нашёл след лесного зверя."
      source: "Подборка «Сказки»"
      kind: 1
      minimumErudition: 0
      answer: ""
    - id: level_v2_c11_t0_n09
      text: "Почтальон нашёл секрет доброго дела."
      source: "Подборка «Сказки»"
      kind: 1
      minimumErudition: 0
      answer: ""
    - id: level_v2_c11_t1_n00
