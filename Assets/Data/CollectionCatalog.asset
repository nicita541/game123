      minimumErudition: 0
      answer: 
    - id: level_v4_c08_t0_n06
      text: "\u041E\u0434\u0438\u043D \u0447\u0435\u0441\u0442\u043D\u044B\u0439
        \u0432\u043E\u043F\u0440\u043E\u0441 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E
        \u0432\u044B\u0432\u043E\u0434\u0438\u0442 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
        \u043A \u0442\u0435\u043C\u0435 \u043E \u0440\u0430\u0437\u0431\u043E\u0440\u0435
        \u043E\u0448\u0438\u0431\u043A\u0438."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041C\u0443\u0434\u0440\u043E\u0441\u0442\u044C\xBB"
