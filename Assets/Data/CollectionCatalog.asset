      text: "\u0427\u0435\u043C \u043A\u043E\u0440\u043E\u0447\u0435 \u0442\u0435\u043A\u0441\u0442,
        \u0442\u0435\u043C \u0437\u0430\u043C\u0435\u0442\u043D\u0435\u0435 \u0440\u043E\u043B\u044C
        \u0442\u0430\u043A\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u0438, \u043A\u0430\u043A
        \u0442\u043E\u0447\u043D\u044B\u0439 \u0440\u0438\u0442\u043C."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t1_n01
      text: "\u042F\u0440\u043A\u0438\u0439 \u043E\u0431\u0440\u0430\u0437 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
        \u0441\u0432\u044F\u0437\u0430\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
        \u0441\u043B\u043E\u0432\u0430 \u0432 \u0446\u0435\u043B\u044C\u043D\u043E\u0435
        \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t1_n02
      text: "\u0421\u0442\u0440\u043E\u0444\u0430 \u0437\u0432\u0443\u0447\u0438\u0442
        \u0442\u043E\u0447\u043D\u0435\u0435, \u043A\u043E\u0433\u0434\u0430 \u0435\u0451
        \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E \u0444\u043E\u0440\u043C\u0443
        \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
        \u0437\u0432\u0443\u043A \u0441\u0442\u0440\u043E\u043A\u0438."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t1_n03
      text: "\u041D\u0435 \u0441\u0440\u0430\u0437\u0443 \u0437\u0430\u043C\u0435\u0442\u043D\u0430\u044F
        \u0434\u0435\u0442\u0430\u043B\u044C \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
        \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439
        \u043F\u043B\u0430\u043D: \u0441\u043C\u044B\u0441\u043B \u043F\u0430\u0443\u0437\u044B."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t1_n04
      text: "\u0412 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0438
        \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0443\u044E
        \u0440\u043E\u043B\u044C \u0438\u0433\u0440\u0430\u0435\u0442 \u0436\u0438\u0432\u0430\u044F
        \u0440\u0438\u0444\u043C\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t1_n05
      text: "\u041F\u043E\u0441\u043B\u0435 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F
        \u043B\u0438\u0448\u043D\u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430
        \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u043F\u0435\u0439\u0437\u0430\u0436\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t1_n06
      text: "\u0421\u043C\u0435\u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u0440\u043E\u043A\u0438
        \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0432\u0430\u0436\u0435\u043D \u0434\u043B\u044F \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438
        \u0433\u043E\u043B\u043E\u0441 \u0447\u0443\u0432\u0441\u0442\u0432\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t1_n07
      text: "\u041C\u0443\u0437\u044B\u043A\u0430 \u0440\u0435\u0447\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
        \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
        \u0431\u0435\u0437 \u043F\u0440\u044F\u043C\u043E\u0433\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F
        \u0447\u0443\u0432\u0441\u0442\u0432\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t1_n08
      text: "\u041E\u0434\u043D\u0430 \u043F\u0430\u0443\u0437\u0430 \u043C\u0435\u043D\u044F\u0435\u0442
        \u0447\u0442\u0435\u043D\u0438\u0435, \u043F\u043E\u0442\u043E\u043C\u0443
        \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435 \u043D\u0435\u0451 \u0438\u043D\u0430\u0447\u0435
        \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
        \u0441\u0432\u0435\u0442 \u043C\u0435\u0442\u0430\u0444\u043E\u0440\u044B."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t1_n09
      text: "\u0412 \u0443\u0434\u0430\u0447\u043D\u043E\u0439 \u0441\u0442\u0440\u043E\u0444\u0435
        \u0441\u043C\u044B\u0441\u043B \u0438 \u0444\u043E\u0440\u043C\u0430 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F
        \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u043C\u044F\u0442\u044C \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 60
      answer: 
    - id: level_v4_c09_t2_n00
      text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0442\u043E\u0447\u043D\u044B\u0439
        \u0440\u0438\u0442\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0439
        \u0434\u0435\u0442\u0430\u043B\u044C\u044E, \u043D\u043E \u0431\u0435\u0437
        \u043D\u0435\u0451 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442 \u0447\u0430\u0441\u0442\u044C
        \u043E\u0431\u0449\u0435\u0433\u043E \u0441\u043C\u044B\u0441\u043B\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t2_n01
      text: "\u042F\u0440\u043A\u0438\u0439 \u043E\u0431\u0440\u0430\u0437 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u0447\u0430\u0441\u0442\u044C\u044E \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438:
        \u044D\u0442\u0430 \u0434\u0435\u0442\u0430\u043B\u044C \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442
        \u043D\u0430\u0447\u0430\u043B\u043E \u0438 \u043A\u043E\u043D\u0435\u0446
        \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F
        \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
        \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
        \u0442\u0435\u043A\u0441\u0442\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t2_n02
      text: "\u041F\u043E\u044D\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0440\u0430\u0437 \u043C\u0435\u043D\u044F\u0435\u0442 \u0441\u0442\u0440\u043E\u043A\u0443,
        \u043F\u043E\u043A\u0430 \u0437\u0432\u0443\u043A \u0441\u0442\u0440\u043E\u043A\u0438
        \u043D\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
        \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043E\u0431\u0440\u0430\u0437\u043E\u043C,
        \u0430 \u043D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0442\u044C
        \u043E\u0442 \u043D\u0435\u0433\u043E."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t2_n03
      text: "\u0427\u0438\u0442\u0430\u0442\u0435\u043B\u044C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u043A \u0441\u0442\u0440\u043E\u0444\u0435 \u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442,
        \u0447\u0442\u043E \u0441\u043C\u044B\u0441\u043B \u043F\u0430\u0443\u0437\u044B
        \u043C\u0435\u043D\u044F\u0435\u0442 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
        \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445 \u0441\u043B\u043E\u0432
        \u043F\u043E\u0441\u043B\u0435 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
        \u043F\u0440\u043E\u0447\u0442\u0435\u043D\u0438\u044F."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t2_n04
      text: "\u0412 \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0438
        \u0436\u0438\u0432\u0430\u044F \u0440\u0438\u0444\u043C\u0430 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
        \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u043C\u0435\u0436\u0434\u0443
        \u043F\u0440\u044F\u043C\u044B\u043C \u0441\u043C\u044B\u0441\u043B\u043E\u043C
        \u0438 \u0442\u0435\u043C, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
        \u043D\u0435\u0434\u043E\u0441\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u043C."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t2_n05
      text: "\u0421\u043C\u0435\u043D\u0430 \u0438\u043D\u0442\u043E\u043D\u0430\u0446\u0438\u0438
        \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u043A\u0430\u043A
        \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u043F\u0435\u0439\u0437\u0430\u0436\u0430
        \u043C\u043E\u0436\u0435\u0442 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
        \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
        \u0437\u0432\u0443\u0447\u0430\u043D\u0438\u0435 \u0432\u0441\u0435\u0439
        \u0441\u0442\u0440\u043E\u0444\u044B."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t2_n06
      text: "\u041F\u043E\u044D\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
        \u0433\u043E\u043B\u043E\u0441 \u0447\u0443\u0432\u0441\u0442\u0432\u0430
        \u043D\u0435 \u0440\u0430\u0434\u0438 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F:
        \u0447\u0435\u0440\u0435\u0437 \u044D\u0442\u0443 \u0434\u0435\u0442\u0430\u043B\u044C
        \u0441\u0442\u0440\u043E\u0444\u0430 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
        \u0442\u043E\u0447\u043D\u043E\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
        \u0438 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0438\u0439\u0441\u044F
        \u043F\u043E\u0432\u043E\u0440\u043E\u0442."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t2_n07
      text: "\u041C\u0443\u0437\u044B\u043A\u0430 \u0440\u0435\u0447\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
        \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u043E\u0435
        \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0431\u0435\u0437 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0433\u043E
        \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
        \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u044E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
        \u0434\u043B\u044F \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
        \u043E\u0442\u0432\u0435\u0442\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t2_n08
      text: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E\u0441\u0442\u044B\u0445
        \u0441\u043B\u043E\u0432 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F
        \u0441\u0438\u043B\u044C\u043D\u0435\u0435, \u043A\u043E\u0433\u0434\u0430
        \u0438\u0445 \u0437\u0432\u0443\u0447\u0430\u043D\u0438\u0435 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442
        \u0441\u0432\u0435\u0442 \u043C\u0435\u0442\u0430\u0444\u043E\u0440\u044B."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t2_n09
      text: "\u0412 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F
        \u043F\u0430\u043C\u044F\u0442\u044C \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F
        \u043C\u0435\u043D\u044F\u0435\u0442 \u0444\u0443\u043D\u043A\u0446\u0438\u044E,
        \u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u044D\u0442\u0438\u043C
        \u0438\u043D\u0430\u0447\u0435 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
        \u043F\u0435\u0440\u0432\u0430\u044F \u0441\u0442\u0440\u043E\u043A\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 160
      answer: 
    - id: level_v4_c09_t3_n00
      text: "\u0410\u043D\u0430\u043B\u0438\u0437 \u0441\u0442\u0440\u043E\u0444\u044B
        \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u0447\u0442\u043E
        \u0442\u043E\u0447\u043D\u044B\u0439 \u0440\u0438\u0442\u043C \u0441\u0432\u044F\u0437\u0430\u043D
        \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E \u0437\u0432\u0443\u0447\u0430\u043D\u0438\u0435\u043C,
        \u043D\u043E \u0438 \u0441 \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u043C
        \u043E\u0431\u0440\u0430\u0437\u043E\u0432, \u043F\u0430\u0443\u0437 \u0438
        \u0441\u043C\u044B\u0441\u043B\u043E\u0432\u044B\u0445 \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u0432."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t3_n01
      text: "\u042F\u0440\u043A\u0438\u0439 \u043E\u0431\u0440\u0430\u0437 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
        \u0441\u0440\u0430\u0437\u0443 \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
        \u0443\u0440\u043E\u0432\u043D\u044F\u0445: \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442
        \u0437\u0432\u0443\u0447\u0430\u043D\u0438\u0435, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
        \u043E\u0431\u0440\u0430\u0437 \u0438 \u043C\u0435\u043D\u044F\u0435\u0442
        \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u044F
        \u043F\u0435\u0440\u0435\u0434 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
        \u0441\u0442\u0440\u043E\u043A\u043E\u0439."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t3_n02
      text: "\u041F\u043E\u044D\u0442 \u0441\u043E\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0439
        \u0440\u0438\u0441\u0443\u043D\u043E\u043A, \u0447\u0442\u043E\u0431\u044B
        \u0437\u0432\u0443\u043A \u0441\u0442\u0440\u043E\u043A\u0438 \u0441\u0442\u0430\u043B
        \u0437\u0430\u043C\u0435\u0442\u043D\u0435\u0435 \u0438 \u043F\u043E\u0434\u0447\u0435\u0440\u043A\u043D\u0443\u043B
        \u043C\u043E\u043C\u0435\u043D\u0442 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E
        \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t3_n03
      text: "\u0412 \u0441\u043B\u043E\u0436\u043D\u043E\u0439 \u0441\u0442\u0440\u043E\u0444\u0435
        \u0441\u043C\u044B\u0441\u043B \u043F\u0430\u0443\u0437\u044B \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442
        \u0434\u0435\u0442\u0430\u043B\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043A\u0430\u0436\u0443\u0442\u0441\u044F
        \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u043C\u0438,
        \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u0438\u0445 \u0432
        \u0435\u0434\u0438\u043D\u043E\u0435 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
        \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t3_n04
      text: "\u0427\u0438\u0442\u0430\u0442\u0435\u043B\u044C \u0441\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u0435\u0442
        \u043D\u0430\u0447\u0430\u043B\u043E \u0438 \u043A\u043E\u043D\u0435\u0446
        \u0442\u0435\u043A\u0441\u0442\u0430 \u0438 \u0432\u0438\u0434\u0438\u0442,
        \u043A\u0430\u043A \u0436\u0438\u0432\u0430\u044F \u0440\u0438\u0444\u043C\u0430
        \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
        \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435\u043C
        \u043B\u0438\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0433\u0435\u0440\u043E\u044F."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t3_n05
      text: "\u041F\u043E\u044D\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C
        \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442 \u043D\u0435 \u0438\u0437
        \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0445
        \u0441\u043B\u043E\u0432, \u0430 \u0438\u0437 \u0442\u043E\u0433\u043E, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0434\u044B\u0445\u0430\u043D\u0438\u0435
        \u043F\u0435\u0439\u0437\u0430\u0436\u0430 \u0432\u043E \u0432\u0441\u0435\u0439
        \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t3_n06
      text: "\u041A\u043E\u0433\u0434\u0430 \u0433\u043E\u043B\u043E\u0441 \u0447\u0443\u0432\u0441\u0442\u0432\u0430
        \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0435
        \u0441 \u043F\u0440\u044F\u043C\u044B\u043C \u0441\u043C\u044B\u0441\u043B\u043E\u043C,
        \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u0442\u043E\u0440\u043E\u0439
        \u0441\u043B\u043E\u0439 \u0442\u0435\u043A\u0441\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
        \u043F\u0440\u043E\u0441\u0442\u044B\u043C \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u043E\u043C."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t3_n07
      text: "\u041F\u043E\u044D\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u043A \u043E\u0434\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u0438
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437,
        \u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u0432\u0442\u043E\u0440
        \u043C\u0435\u043D\u044F\u0435\u0442 \u043C\u0443\u0437\u044B\u043A\u0430
        \u0440\u0435\u0447\u0438, \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044F
        \u043D\u043E\u0432\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
        \u043A \u0443\u0436\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0439
        \u0441\u0442\u0440\u043E\u043A\u0435."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t3_n08
      text: "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0435 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435
        \u0441\u0442\u0440\u043E\u0444\u044B \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
        \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u0432\u0435\u0442
        \u043C\u0435\u0442\u0430\u0444\u043E\u0440\u044B \u0441\u043D\u0430\u0447\u0430\u043B\u0430
        \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043E\u0434\u043D\u043E \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435,
        \u0430 \u0437\u0430\u0442\u0435\u043C \u0432\u0435\u0434\u0451\u0442 \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u044F
        \u0432 \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t3_n09
      text: "\u0421\u043B\u043E\u0436\u043D\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
        \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043F\u043E\u043D\u044F\u0442\u043D\u0435\u0435
        \u0447\u0435\u0440\u0435\u0437 \u0444\u043E\u0440\u043C\u0443: \u043F\u0430\u043C\u044F\u0442\u044C
        \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
        \u0440\u0430\u0437\u043D\u044B\u0435 \u043E\u0442\u0442\u0435\u043D\u043A\u0438
        \u0438 \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
        \u0442\u0435\u043A\u0441\u0442\u0443 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F
        \u0432 \u043F\u0440\u044F\u043C\u043E\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 320
      answer: 
    - id: level_v4_c09_t4_n00
      text: "\u0421\u0438\u043B\u044C\u043D\u043E\u0435 \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435
        \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442 \u043A\u0430\u0436\u0434\u043E\u0435
        \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E:
        \u0442\u043E\u0447\u043D\u044B\u0439 \u0440\u0438\u0442\u043C \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
        \u0430\u043A\u0446\u0435\u043D\u0442\u044B \u0442\u0430\u043A, \u0447\u0442\u043E
        \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u044C \u0441\u0430\u043C \u0434\u043E\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442
        \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0435\u0435 \u0438
        \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u043C
        \u0441\u043C\u044B\u0441\u043B\u043E\u0432\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
    - id: level_v4_c09_t4_n01
      text: "\u042F\u0440\u043A\u0438\u0439 \u043E\u0431\u0440\u0430\u0437 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043E\u0439
        \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F:
        \u0434\u0435\u0442\u0430\u043B\u044C \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442
        \u0440\u0438\u0442\u043C, \u043E\u0431\u0440\u0430\u0437 \u0438 \u0441\u043C\u044B\u0441\u043B\u043E\u0432\u044B\u0435
        \u043F\u0430\u0443\u0437\u044B, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
        \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043E\u0434\u043D\u043E\u0439
        \u0441\u0442\u0440\u043E\u043A\u0438 \u043E\u0442\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0432\u043E \u0432\u0441\u0435\u0439 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438
        \u0438 \u043C\u0435\u043D\u044F\u0435\u0442 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0435
        \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
    - id: level_v4_c09_t4_n02
      text: "\u041F\u043E\u044D\u0442 \u0441\u0442\u0440\u043E\u0438\u0442 \u0442\u0435\u043A\u0441\u0442
        \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u0437\u0432\u0443\u043A
        \u0441\u0442\u0440\u043E\u043A\u0438 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
        \u043C\u0435\u043D\u044F\u043B \u0444\u0443\u043D\u043A\u0446\u0438\u044E:
        \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u0434\u0430\u0432\u0430\u043B
        \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435, \u0437\u0430\u0442\u0435\u043C
        \u043D\u0430\u0440\u0443\u0448\u0430\u043B \u0435\u0433\u043E \u0438 \u0432
        \u043A\u043E\u043D\u0446\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u043B
        \u043F\u043E-\u043D\u043E\u0432\u043E\u043C\u0443 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
        \u0441\u0430\u043C\u043E\u0435 \u043D\u0430\u0447\u0430\u043B\u043E."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
    - id: level_v4_c09_t4_n03
      text: "\u041F\u0440\u0438 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u043C
        \u0447\u0442\u0435\u043D\u0438\u0438 \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E
        \u0441\u043C\u044B\u0441\u043B \u043F\u0430\u0443\u0437\u044B \u043D\u0435
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
        \u043E\u0442 \u0441\u043C\u044B\u0441\u043B\u0430: \u044D\u0442\u0430 \u0434\u0435\u0442\u0430\u043B\u044C
        \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0442\u0435\u043C\u043F\u043E\u043C,
        \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
        \u0441\u043B\u043E\u0432\u0430 \u0438 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
        \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
        \u0434\u043B\u044F \u043D\u0435\u0432\u044B\u0441\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0433\u043E."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
    - id: level_v4_c09_t4_n04
      text: "\u0421\u043B\u043E\u0436\u043D\u0430\u044F \u0441\u0442\u0440\u043E\u0444\u0430
        \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0439,
        \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0436\u0438\u0432\u0430\u044F
        \u0440\u0438\u0444\u043C\u0430 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
        \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
        \u043F\u0440\u044F\u043C\u043E\u0439 \u043E\u0431\u0440\u0430\u0437 \u0438
        \u043D\u0430\u043C\u0435\u043A\u0430\u0435\u0442 \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439
        \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
        \u0441\u043B\u043E\u0439."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
    - id: level_v4_c09_t4_n05
      text: "\u041F\u043E\u044D\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0444\u043E\u0440\u043C\u0430
        \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439,
        \u043A\u043E\u0433\u0434\u0430 \u0434\u044B\u0445\u0430\u043D\u0438\u0435
        \u043F\u0435\u0439\u0437\u0430\u0436\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
        \u043D\u0435 \u043A\u0430\u043A \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435,
        \u0430 \u043A\u0430\u043A \u0441\u0438\u0441\u0442\u0435\u043C\u0430: \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442\u0441\u044F,
        \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0432 \u0444\u0438\u043D\u0430\u043B\u0435 \u0443\u0436\u0435 \u0441 \u043D\u043E\u0432\u044B\u043C
        \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435\u043C."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
    - id: level_v4_c09_t4_n06
      text: "\u0427\u0438\u0442\u0430\u0442\u0435\u043B\u044C \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442,
        \u043A\u0430\u043A \u0433\u043E\u043B\u043E\u0441 \u0447\u0443\u0432\u0441\u0442\u0432\u0430
        \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442 \u0434\u0430\u043B\u0451\u043A\u0438\u0435
        \u0434\u0435\u0442\u0430\u043B\u0438 \u0442\u0435\u043A\u0441\u0442\u0430;
        \u0438\u043C\u0435\u043D\u043D\u043E \u044D\u0442\u0430 \u0441\u0432\u044F\u0437\u044C
        \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
        \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435 \u0441\u0442\u0440\u043E\u043A\u0438
        \u0432 \u0446\u0435\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0435
        \u0441 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u043B\u043E\u0433\u0438\u043A\u043E\u0439."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
    - id: level_v4_c09_t4_n07
      text: "\u041F\u043E\u044D\u0442 \u0441\u043E\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0435\u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u043E\u0441\u0442\u044C,
        \u0438 \u043C\u0443\u0437\u044B\u043A\u0430 \u0440\u0435\u0447\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
        \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0435\u0451: \u0437\u0432\u0443\u0447\u0430\u043D\u0438\u0435
        \u0432\u0435\u0434\u0451\u0442 \u0432 \u043E\u0434\u043D\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
        \u043E\u0431\u0440\u0430\u0437 \u2014 \u0432 \u0434\u0440\u0443\u0433\u0443\u044E,
        \u0430 \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
        \u0441\u043C\u044B\u0441\u043B \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442
        \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
    - id: level_v4_c09_t4_n08
      text: "\u0420\u0430\u0437\u0431\u043E\u0440 \u0441\u0442\u0438\u0445\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F
        \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u0447\u0442\u043E
        \u0441\u0432\u0435\u0442 \u043C\u0435\u0442\u0430\u0444\u043E\u0440\u044B
        \u0441\u0432\u044F\u0437\u0430\u043D \u0441 \u0432\u044B\u0431\u043E\u0440\u043E\u043C
        \u0441\u043B\u043E\u0432, \u0434\u043B\u0438\u043D\u043E\u0439 \u0444\u0440\u0430\u0437
        \u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C
        \u043F\u0430\u0443\u0437; \u0432\u043C\u0435\u0441\u0442\u0435 \u043E\u043D\u0438
        \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
        \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
        \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u044B\u043C
        \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u043E\u043C."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
    - id: level_v4_c09_t4_n09
      text: "\u0412 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u0440\u043E\u0444\u0435
        \u043F\u0430\u043C\u044F\u0442\u044C \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F
        \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043C\u043E\u0442\u0438\u0432
        \u0438\u0437 \u043D\u0430\u0447\u0430\u043B\u0430, \u043D\u043E \u0443\u0436\u0435
        \u043F\u043E\u0441\u043B\u0435 \u0432\u0441\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u043E\u0433\u043E
        \u0442\u0435\u043A\u0441\u0442\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
        \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F \u0434\u0435\u0442\u0430\u043B\u044C
        \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0435
        \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
        \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442
        \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044E."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041F\u043E\u044D\u0437\u0438\u044F\xBB"
      kind: 0
      minimumErudition: 560
      answer: 
