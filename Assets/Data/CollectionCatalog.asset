    - id: level_v4_c13_t0_n01
      text: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0434\u0435\u043D\u044C
        \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
