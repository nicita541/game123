    - id: level_v4_c15_t2_n00
      text: "\u0418\u0434\u0451\u0442 \u0440\u044F\u0434\u043E\u043C, \u0445\u043E\u0442\u044F
        \u043D\u043E\u0433 \u0443 \u043D\u0435\u0451 \u043D\u0435\u0442. \u0414\u043D\u0451\u043C
        \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0437\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
        \u0430 \u043D\u043E\u0447\u044C\u044E \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442.
        \u042F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C \u0432
        \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
        \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
        \u041D\u0430\u0439\u0434\u0438 \u0440\u0430\u0437\u0433\u0430\u0434\u043A\u0443?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u0422\u0435\u043D\u044C"
    - id: level_v4_c15_t2_n01
      text: "\u041C\u043E\u043B\u0447\u0438\u0442, \u043D\u043E \u0443\u043C\u0435\u0435\u0442
        \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C.
        \u0412\u043D\u0443\u0442\u0440\u0438 \u043D\u0435\u0451 \u0436\u0438\u0432\u0443\u0442
        \u0441\u0442\u0440\u043E\u043A\u0438, \u0433\u043B\u0430\u0432\u044B \u0438
        \u0447\u0443\u0436\u0438\u0435 \u0441\u0443\u0434\u044C\u0431\u044B. \u042F
        \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439
        \u0436\u0438\u0437\u043D\u0438 \u0447\u0430\u0449\u0435, \u0447\u0435\u043C
        \u043A\u0430\u0436\u0435\u0442\u0441\u044F. \u041E \u0447\u0451\u043C \u0440\u0435\u0447\u044C?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u041A\u043D\u0438\u0433\u0430"
    - id: level_v4_c15_t2_n02
      text: "\u0420\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
        \u043D\u0435\u0431\u043E \u043F\u043B\u0430\u0447\u0435\u0442. \u0414\u0435\u0440\u0436\u0438\u0442\u0441\u044F
        \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u043D\u0435
        \u043B\u044E\u0431\u0438\u0442 \u0441\u0438\u043B\u044C\u043D\u044B\u0439
        \u0432\u0435\u0442\u0435\u0440. \u042F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C
        \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
        \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
        \u0427\u0442\u043E \u0441\u043A\u0440\u044B\u0442\u043E \u0432 \u0437\u0430\u0433\u0430\u0434\u043A\u0435?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u0417\u043E\u043D\u0442"
    - id: level_v4_c15_t2_n03
      text: "\u0418\u0434\u0443\u0442 \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C,
        \u043E\u0441\u0442\u0430\u0432\u0430\u044F\u0441\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435.
        \u0421\u0447\u0438\u0442\u0430\u044E\u0442 \u0442\u043E, \u0447\u0442\u043E
        \u043D\u0435\u043B\u044C\u0437\u044F \u0432\u0435\u0440\u043D\u0443\u0442\u044C.
        \u042F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C \u0432
        \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
        \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
        \u041A\u0430\u043A\u043E\u0439 \u043E\u0442\u0432\u0435\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u0427\u0430\u0441\u044B"
    - id: level_v4_c15_t2_n04
      text: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
        \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0435
        \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E.
        \u0411\u0435\u0437 \u043D\u0435\u0433\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F
        \u0434\u0432\u0435\u0440\u044C \u043C\u043E\u0436\u0435\u0442 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
        \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439. \u042F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C
        \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
        \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
        \u0427\u0442\u043E \u044F \u0442\u0430\u043A\u043E\u0435?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u041A\u043B\u044E\u0447"
    - id: level_v4_c15_t2_n05
      text: "\u041F\u0430\u0434\u0430\u0435\u0442 \u0442\u0438\u0445\u043E \u0438
        \u043C\u0435\u043D\u044F\u0435\u0442 \u0446\u0432\u0435\u0442 \u0443\u043B\u0438\u0446\u044B.
        \u0412 \u0442\u0451\u043F\u043B\u043E\u0439 \u043B\u0430\u0434\u043E\u043D\u0438
        \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0432 \u0432\u043E\u0434\u0443. \u042F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C
        \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
        \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
        \u0423\u0433\u0430\u0434\u0430\u0439 \u043E\u0442\u0432\u0435\u0442?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u0421\u043D\u0435\u0433"
    - id: level_v4_c15_t2_n06
      text: "\u041E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u043C
        \u0433\u043E\u043B\u043E\u0441\u043E\u043C, \u0445\u043E\u0442\u044F \u0440\u044F\u0434\u043E\u043C
        \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435\u0442. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
        \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043B\u044B\u0448\u043D\u043E
        \u0441\u0440\u0435\u0434\u0438 \u0441\u043A\u0430\u043B \u0438 \u043F\u0443\u0441\u0442\u044B\u0445
        \u0437\u0430\u043B\u043E\u0432. \u042F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C
        \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
        \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
        \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u043D\u0430\u0437\u0432\u0430\u0442\u044C
        \u043C\u0435\u043D\u044F?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u042D\u0445\u043E"
    - id: level_v4_c15_t2_n07
      text: "\u0412\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435
        \u0434\u043E\u0436\u0434\u044F, \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0441\u043E\u043B\u043D\u0446\u0435. \u0415\u0451 \u0446\u0432\u0435\u0442\u0430
        \u0432\u0438\u0434\u043D\u044B \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430,
        \u043D\u043E \u043A \u043D\u0438\u043C \u043D\u0435\u043B\u044C\u0437\u044F
        \u043F\u043E\u0434\u043E\u0439\u0442\u0438. \u042F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C
        \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
        \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
        \u041A\u0442\u043E \u044F?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u0420\u0430\u0434\u0443\u0433\u0430"
    - id: level_v4_c15_t2_n08
      text: "\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0438,
        \u043E\u0441\u0442\u0430\u0432\u0430\u044F\u0441\u044C \u043D\u0430 \u0441\u0442\u043E\u043B\u0435.
        \u041D\u0430 \u043D\u0435\u0439 \u0435\u0441\u0442\u044C \u043C\u043E\u0440\u044F
        \u0438 \u0433\u043E\u0440\u043E\u0434\u0430 \u0431\u0435\u0437 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439
        \u0432\u043E\u0434\u044B \u0438 \u0434\u043E\u043C\u043E\u0432. \u042F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C
        \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
        \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
        \u0427\u0442\u043E \u044D\u0442\u043E?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u041A\u0430\u0440\u0442\u0430"
    - id: level_v4_c15_t2_n09
      text: "\u0421\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043C\u0435\u043D\u044C\u0448\u0435,
        \u043F\u043E\u043A\u0430 \u0434\u0430\u0451\u0442 \u0441\u0432\u0435\u0442.
        \u0415\u0451 \u043E\u0433\u043E\u043D\u044C \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
        \u043D\u0443\u0436\u0435\u043D, \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u043A\u0440\u0443\u0433
        \u0442\u0435\u043C\u043D\u043E. \u042F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C
        \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
        \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
        \u041D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 160
      answer: "\u0421\u0432\u0435\u0447\u0430"
    - id: level_v4_c15_t3_n00
      text: "\u0418\u0434\u0451\u0442 \u0440\u044F\u0434\u043E\u043C, \u0445\u043E\u0442\u044F
        \u043D\u043E\u0433 \u0443 \u043D\u0435\u0451 \u043D\u0435\u0442, \u043D\u043E
        \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0430\u044F
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430. \u0414\u043D\u0451\u043C
        \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0437\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
        \u0430 \u043D\u043E\u0447\u044C\u044E \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442.
        \u041E\u0442\u0432\u0435\u0442 \u043D\u0443\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C
        \u0441\u0440\u0435\u0434\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
        \u0432\u0435\u0449\u0435\u0439 \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439.
        \u041D\u0430\u0439\u0434\u0438 \u0440\u0430\u0437\u0433\u0430\u0434\u043A\u0443?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u0422\u0435\u043D\u044C"
    - id: level_v4_c15_t3_n01
      text: "\u041C\u043E\u043B\u0447\u0438\u0442, \u043D\u043E \u0443\u043C\u0435\u0435\u0442
        \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C,
        \u043D\u043E \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0430\u044F
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430. \u0412\u043D\u0443\u0442\u0440\u0438
        \u043D\u0435\u0451 \u0436\u0438\u0432\u0443\u0442 \u0441\u0442\u0440\u043E\u043A\u0438,
        \u0433\u043B\u0430\u0432\u044B \u0438 \u0447\u0443\u0436\u0438\u0435 \u0441\u0443\u0434\u044C\u0431\u044B.
        \u041E\u0442\u0432\u0435\u0442 \u043D\u0443\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C
        \u0441\u0440\u0435\u0434\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
        \u0432\u0435\u0449\u0435\u0439 \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439.
        \u041E \u0447\u0451\u043C \u0440\u0435\u0447\u044C?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u041A\u043D\u0438\u0433\u0430"
    - id: level_v4_c15_t3_n02
      text: "\u0420\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
        \u043D\u0435\u0431\u043E \u043F\u043B\u0430\u0447\u0435\u0442, \u043D\u043E
        \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0430\u044F
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430. \u0414\u0435\u0440\u0436\u0438\u0442\u0441\u044F
        \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u043D\u0435
        \u043B\u044E\u0431\u0438\u0442 \u0441\u0438\u043B\u044C\u043D\u044B\u0439
        \u0432\u0435\u0442\u0435\u0440. \u041E\u0442\u0432\u0435\u0442 \u043D\u0443\u0436\u043D\u043E
        \u0438\u0441\u043A\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
        \u0432\u0435\u0449\u0435\u0439 \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439.
        \u0427\u0442\u043E \u0441\u043A\u0440\u044B\u0442\u043E \u0432 \u0437\u0430\u0433\u0430\u0434\u043A\u0435?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u0417\u043E\u043D\u0442"
    - id: level_v4_c15_t3_n03
      text: "\u0418\u0434\u0443\u0442 \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C,
        \u043E\u0441\u0442\u0430\u0432\u0430\u044F\u0441\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435,
        \u043D\u043E \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0430\u044F
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430. \u0421\u0447\u0438\u0442\u0430\u044E\u0442
        \u0442\u043E, \u0447\u0442\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0432\u0435\u0440\u043D\u0443\u0442\u044C.
        \u041E\u0442\u0432\u0435\u0442 \u043D\u0443\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C
        \u0441\u0440\u0435\u0434\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
        \u0432\u0435\u0449\u0435\u0439 \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439.
        \u041A\u0430\u043A\u043E\u0439 \u043E\u0442\u0432\u0435\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u0427\u0430\u0441\u044B"
    - id: level_v4_c15_t3_n04
      text: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
        \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0435
        \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E,
        \u043D\u043E \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0430\u044F
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430. \u0411\u0435\u0437
        \u043D\u0435\u0433\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F
        \u0434\u0432\u0435\u0440\u044C \u043C\u043E\u0436\u0435\u0442 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
        \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439. \u041E\u0442\u0432\u0435\u0442
        \u043D\u0443\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0438
        \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445 \u0432\u0435\u0449\u0435\u0439
        \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439. \u0427\u0442\u043E \u044F
        \u0442\u0430\u043A\u043E\u0435?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u041A\u043B\u044E\u0447"
    - id: level_v4_c15_t3_n05
      text: "\u041F\u0430\u0434\u0430\u0435\u0442 \u0442\u0438\u0445\u043E \u0438
        \u043C\u0435\u043D\u044F\u0435\u0442 \u0446\u0432\u0435\u0442 \u0443\u043B\u0438\u0446\u044B,
        \u043D\u043E \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0430\u044F
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430. \u0412 \u0442\u0451\u043F\u043B\u043E\u0439
        \u043B\u0430\u0434\u043E\u043D\u0438 \u0431\u044B\u0441\u0442\u0440\u043E
        \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0432 \u0432\u043E\u0434\u0443. \u041E\u0442\u0432\u0435\u0442 \u043D\u0443\u0436\u043D\u043E
        \u0438\u0441\u043A\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
        \u0432\u0435\u0449\u0435\u0439 \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439.
        \u0423\u0433\u0430\u0434\u0430\u0439 \u043E\u0442\u0432\u0435\u0442?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u0421\u043D\u0435\u0433"
    - id: level_v4_c15_t3_n06
      text: "\u041E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u043C
        \u0433\u043E\u043B\u043E\u0441\u043E\u043C, \u0445\u043E\u0442\u044F \u0440\u044F\u0434\u043E\u043C
        \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435\u0442, \u043D\u043E \u044D\u0442\u043E
        \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0430\u044F
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
        \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043B\u044B\u0448\u043D\u043E
        \u0441\u0440\u0435\u0434\u0438 \u0441\u043A\u0430\u043B \u0438 \u043F\u0443\u0441\u0442\u044B\u0445
        \u0437\u0430\u043B\u043E\u0432. \u041E\u0442\u0432\u0435\u0442 \u043D\u0443\u0436\u043D\u043E
        \u0438\u0441\u043A\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
        \u0432\u0435\u0449\u0435\u0439 \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439.
        \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u043D\u0430\u0437\u0432\u0430\u0442\u044C
        \u043C\u0435\u043D\u044F?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u042D\u0445\u043E"
    - id: level_v4_c15_t3_n07
      text: "\u0412\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435
        \u0434\u043E\u0436\u0434\u044F, \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0441\u043E\u043B\u043D\u0446\u0435, \u043D\u043E \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
        \u043F\u0435\u0440\u0432\u0430\u044F \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430.
        \u0415\u0451 \u0446\u0432\u0435\u0442\u0430 \u0432\u0438\u0434\u043D\u044B
        \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430, \u043D\u043E \u043A \u043D\u0438\u043C
        \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u043E\u0434\u043E\u0439\u0442\u0438.
        \u041E\u0442\u0432\u0435\u0442 \u043D\u0443\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C
        \u0441\u0440\u0435\u0434\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
        \u0432\u0435\u0449\u0435\u0439 \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439.
        \u041A\u0442\u043E \u044F?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u0420\u0430\u0434\u0443\u0433\u0430"
    - id: level_v4_c15_t3_n08
      text: "\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0438,
        \u043E\u0441\u0442\u0430\u0432\u0430\u044F\u0441\u044C \u043D\u0430 \u0441\u0442\u043E\u043B\u0435,
        \u043D\u043E \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0430\u044F
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430. \u041D\u0430 \u043D\u0435\u0439
        \u0435\u0441\u0442\u044C \u043C\u043E\u0440\u044F \u0438 \u0433\u043E\u0440\u043E\u0434\u0430
        \u0431\u0435\u0437 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439
        \u0432\u043E\u0434\u044B \u0438 \u0434\u043E\u043C\u043E\u0432. \u041E\u0442\u0432\u0435\u0442
        \u043D\u0443\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0438
        \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445 \u0432\u0435\u0449\u0435\u0439
        \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439. \u0427\u0442\u043E \u044D\u0442\u043E?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u041A\u0430\u0440\u0442\u0430"
    - id: level_v4_c15_t3_n09
      text: "\u0421\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043C\u0435\u043D\u044C\u0448\u0435,
        \u043F\u043E\u043A\u0430 \u0434\u0430\u0451\u0442 \u0441\u0432\u0435\u0442,
        \u043D\u043E \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0430\u044F
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430. \u0415\u0451 \u043E\u0433\u043E\u043D\u044C
        \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043D\u0443\u0436\u0435\u043D,
        \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u043A\u0440\u0443\u0433 \u0442\u0435\u043C\u043D\u043E.
        \u041E\u0442\u0432\u0435\u0442 \u043D\u0443\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C
        \u0441\u0440\u0435\u0434\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
        \u0432\u0435\u0449\u0435\u0439 \u0438 \u044F\u0432\u043B\u0435\u043D\u0438\u0439.
        \u041D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 320
      answer: "\u0421\u0432\u0435\u0447\u0430"
    - id: level_v4_c15_t4_n00
      text: "\u0418\u0434\u0451\u0442 \u0440\u044F\u0434\u043E\u043C, \u0445\u043E\u0442\u044F
        \u043D\u043E\u0433 \u0443 \u043D\u0435\u0451 \u043D\u0435\u0442. \u0414\u043D\u0451\u043C
        \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0437\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
        \u0430 \u043D\u043E\u0447\u044C\u044E \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442.
        \u041E\u0434\u043D\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
        \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0439
        \u043F\u0440\u0438\u0437\u043D\u0430\u043A, \u0434\u0440\u0443\u0433\u0430\u044F
        \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u0440\u043E\u043B\u044C.
        \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445, \u043E\u0442\u0431\u0440\u043E\u0441\u044C
        \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442.
        \u041D\u0430\u0439\u0434\u0438 \u0440\u0430\u0437\u0433\u0430\u0434\u043A\u0443?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u0422\u0435\u043D\u044C"
    - id: level_v4_c15_t4_n01
      text: "\u041C\u043E\u043B\u0447\u0438\u0442, \u043D\u043E \u0443\u043C\u0435\u0435\u0442
        \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C.
        \u0412\u043D\u0443\u0442\u0440\u0438 \u043D\u0435\u0451 \u0436\u0438\u0432\u0443\u0442
        \u0441\u0442\u0440\u043E\u043A\u0438, \u0433\u043B\u0430\u0432\u044B \u0438
        \u0447\u0443\u0436\u0438\u0435 \u0441\u0443\u0434\u044C\u0431\u044B. \u041E\u0434\u043D\u0430
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
        \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u043F\u0440\u0438\u0437\u043D\u0430\u043A,
        \u0434\u0440\u0443\u0433\u0430\u044F \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E
        \u0440\u043E\u043B\u044C. \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445,
        \u043E\u0442\u0431\u0440\u043E\u0441\u044C \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435
        \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435 \u0438 \u043D\u0430\u0437\u043E\u0432\u0438
        \u043E\u0442\u0432\u0435\u0442. \u041E \u0447\u0451\u043C \u0440\u0435\u0447\u044C?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u041A\u043D\u0438\u0433\u0430"
    - id: level_v4_c15_t4_n02
      text: "\u0420\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
        \u043D\u0435\u0431\u043E \u043F\u043B\u0430\u0447\u0435\u0442. \u0414\u0435\u0440\u0436\u0438\u0442\u0441\u044F
        \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u043D\u0435
        \u043B\u044E\u0431\u0438\u0442 \u0441\u0438\u043B\u044C\u043D\u044B\u0439
        \u0432\u0435\u0442\u0435\u0440. \u041E\u0434\u043D\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
        \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0439
        \u043F\u0440\u0438\u0437\u043D\u0430\u043A, \u0434\u0440\u0443\u0433\u0430\u044F
        \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u0440\u043E\u043B\u044C.
        \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445, \u043E\u0442\u0431\u0440\u043E\u0441\u044C
        \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442.
        \u0427\u0442\u043E \u0441\u043A\u0440\u044B\u0442\u043E \u0432 \u0437\u0430\u0433\u0430\u0434\u043A\u0435?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u0417\u043E\u043D\u0442"
    - id: level_v4_c15_t4_n03
      text: "\u0418\u0434\u0443\u0442 \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C,
        \u043E\u0441\u0442\u0430\u0432\u0430\u044F\u0441\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435.
        \u0421\u0447\u0438\u0442\u0430\u044E\u0442 \u0442\u043E, \u0447\u0442\u043E
        \u043D\u0435\u043B\u044C\u0437\u044F \u0432\u0435\u0440\u043D\u0443\u0442\u044C.
        \u041E\u0434\u043D\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
        \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0439
        \u043F\u0440\u0438\u0437\u043D\u0430\u043A, \u0434\u0440\u0443\u0433\u0430\u044F
        \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u0440\u043E\u043B\u044C.
        \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445, \u043E\u0442\u0431\u0440\u043E\u0441\u044C
        \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442.
        \u041A\u0430\u043A\u043E\u0439 \u043E\u0442\u0432\u0435\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u0427\u0430\u0441\u044B"
    - id: level_v4_c15_t4_n04
      text: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
        \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0435
        \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E.
        \u0411\u0435\u0437 \u043D\u0435\u0433\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F
        \u0434\u0432\u0435\u0440\u044C \u043C\u043E\u0436\u0435\u0442 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
        \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439. \u041E\u0434\u043D\u0430
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
        \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u043F\u0440\u0438\u0437\u043D\u0430\u043A,
        \u0434\u0440\u0443\u0433\u0430\u044F \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E
        \u0440\u043E\u043B\u044C. \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445,
        \u043E\u0442\u0431\u0440\u043E\u0441\u044C \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435
        \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435 \u0438 \u043D\u0430\u0437\u043E\u0432\u0438
        \u043E\u0442\u0432\u0435\u0442. \u0427\u0442\u043E \u044F \u0442\u0430\u043A\u043E\u0435?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u041A\u043B\u044E\u0447"
    - id: level_v4_c15_t4_n05
      text: "\u041F\u0430\u0434\u0430\u0435\u0442 \u0442\u0438\u0445\u043E \u0438
        \u043C\u0435\u043D\u044F\u0435\u0442 \u0446\u0432\u0435\u0442 \u0443\u043B\u0438\u0446\u044B.
        \u0412 \u0442\u0451\u043F\u043B\u043E\u0439 \u043B\u0430\u0434\u043E\u043D\u0438
        \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0432 \u0432\u043E\u0434\u0443. \u041E\u0434\u043D\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
        \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0439
        \u043F\u0440\u0438\u0437\u043D\u0430\u043A, \u0434\u0440\u0443\u0433\u0430\u044F
        \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u0440\u043E\u043B\u044C.
        \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445, \u043E\u0442\u0431\u0440\u043E\u0441\u044C
        \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442.
        \u0423\u0433\u0430\u0434\u0430\u0439 \u043E\u0442\u0432\u0435\u0442?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u0421\u043D\u0435\u0433"
    - id: level_v4_c15_t4_n06
      text: "\u041E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u043C
        \u0433\u043E\u043B\u043E\u0441\u043E\u043C, \u0445\u043E\u0442\u044F \u0440\u044F\u0434\u043E\u043C
        \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435\u0442. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
        \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043B\u044B\u0448\u043D\u043E
        \u0441\u0440\u0435\u0434\u0438 \u0441\u043A\u0430\u043B \u0438 \u043F\u0443\u0441\u0442\u044B\u0445
        \u0437\u0430\u043B\u043E\u0432. \u041E\u0434\u043D\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
        \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0439
        \u043F\u0440\u0438\u0437\u043D\u0430\u043A, \u0434\u0440\u0443\u0433\u0430\u044F
        \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u0440\u043E\u043B\u044C.
        \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445, \u043E\u0442\u0431\u0440\u043E\u0441\u044C
        \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442.
        \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u043D\u0430\u0437\u0432\u0430\u0442\u044C
        \u043C\u0435\u043D\u044F?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u042D\u0445\u043E"
    - id: level_v4_c15_t4_n07
      text: "\u0412\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435
        \u0434\u043E\u0436\u0434\u044F, \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0441\u043E\u043B\u043D\u0446\u0435. \u0415\u0451 \u0446\u0432\u0435\u0442\u0430
        \u0432\u0438\u0434\u043D\u044B \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430,
        \u043D\u043E \u043A \u043D\u0438\u043C \u043D\u0435\u043B\u044C\u0437\u044F
        \u043F\u043E\u0434\u043E\u0439\u0442\u0438. \u041E\u0434\u043D\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
        \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0439
        \u043F\u0440\u0438\u0437\u043D\u0430\u043A, \u0434\u0440\u0443\u0433\u0430\u044F
        \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u0440\u043E\u043B\u044C.
        \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445, \u043E\u0442\u0431\u0440\u043E\u0441\u044C
        \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442.
        \u041A\u0442\u043E \u044F?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u0420\u0430\u0434\u0443\u0433\u0430"
    - id: level_v4_c15_t4_n08
      text: "\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0438,
        \u043E\u0441\u0442\u0430\u0432\u0430\u044F\u0441\u044C \u043D\u0430 \u0441\u0442\u043E\u043B\u0435.
        \u041D\u0430 \u043D\u0435\u0439 \u0435\u0441\u0442\u044C \u043C\u043E\u0440\u044F
        \u0438 \u0433\u043E\u0440\u043E\u0434\u0430 \u0431\u0435\u0437 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439
        \u0432\u043E\u0434\u044B \u0438 \u0434\u043E\u043C\u043E\u0432. \u041E\u0434\u043D\u0430
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
        \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u043F\u0440\u0438\u0437\u043D\u0430\u043A,
        \u0434\u0440\u0443\u0433\u0430\u044F \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E
        \u0440\u043E\u043B\u044C. \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445,
        \u043E\u0442\u0431\u0440\u043E\u0441\u044C \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435
        \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435 \u0438 \u043D\u0430\u0437\u043E\u0432\u0438
        \u043E\u0442\u0432\u0435\u0442. \u0427\u0442\u043E \u044D\u0442\u043E?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u041A\u0430\u0440\u0442\u0430"
    - id: level_v4_c15_t4_n09
      text: "\u0421\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043C\u0435\u043D\u044C\u0448\u0435,
        \u043F\u043E\u043A\u0430 \u0434\u0430\u0451\u0442 \u0441\u0432\u0435\u0442.
        \u0415\u0451 \u043E\u0433\u043E\u043D\u044C \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
        \u043D\u0443\u0436\u0435\u043D, \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u043A\u0440\u0443\u0433
        \u0442\u0435\u043C\u043D\u043E. \u041E\u0434\u043D\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
        \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0439
        \u043F\u0440\u0438\u0437\u043D\u0430\u043A, \u0434\u0440\u0443\u0433\u0430\u044F
        \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u0440\u043E\u043B\u044C.
        \u0421\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445, \u043E\u0442\u0431\u0440\u043E\u0441\u044C
        \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435
        \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442.
        \u041D\u0430\u0437\u043E\u0432\u0438 \u043E\u0442\u0432\u0435\u0442?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 3
      minimumErudition: 560
      answer: "\u0421\u0432\u0435\u0447\u0430"
