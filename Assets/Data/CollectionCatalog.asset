      answer: 
    - id: level_v4_c14_t2_n04
      text: "\u0420\u0430\u0437\u0443\u043C\u043D\u0430\u044F \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u044C
        \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0441\u0438\u043B\u044C\u043D\u0435\u0435,
        \u043A\u043E\u0433\u0434\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
        \u0443\u043C\u0435\u0435\u0442 \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u044C
        \u0441\u0432\u043E\u044E \u043E\u0448\u0438\u0431\u043A\u0443 \u0431\u0435\u0437
        \u043B\u0438\u0448\u043D\u0438\u0445 \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u043D\u0438\u0439."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
