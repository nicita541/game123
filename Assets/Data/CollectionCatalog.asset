    - id: level_v4_c10_t0_n02
      text: "\u0412 \u0441\u0442\u0430\u0440\u043E\u043C \u044F\u0449\u0438\u043A\u0435
        \u0441\u043E\u0441\u0435\u0434 \u0437\u0430\u043C\u0435\u0442\u0438\u043B
        \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0439 \u0434\u043D\u0435\u0432\u043D\u0438\u043A."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u0420\u043E\u043C\u0430\u043D\u044B\xBB"
      kind: 1
      minimumErudition: 0
      answer: 
    - id: level_v4_c10_t0_n03
      text: "\u041F\u0435\u0440\u0435\u0434 \u0434\u043E\u0440\u043E\u0433\u043E\u0439
        \u0443\u0447\u0438\u0442\u0435\u043B\u044C \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
        \u0443\u0432\u0438\u0434\u0435\u043B \u0437\u0430\u0431\u044B\u0442\u044B\u0439
        \u043F\u043E\u0440\u0442\u0440\u0435\u0442."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u0420\u043E\u043C\u0430\u043D\u044B\xBB"
      kind: 1
      minimumErudition: 0
      answer: 
    - id: level_v4_c10_t0_n04
      text: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0434\u0435\u043D\u044C
        \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
        \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444 \u043D\u0430\u0448\u0451\u043B
        \u043F\u0438\u0441\u044C\u043C\u043E \u043E \u0441\u043F\u043E\u0440\u0435
        \u0434\u0432\u0443\u0445 \u0434\u0440\u0443\u0437\u0435\u0439."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u0420\u043E\u043C\u0430\u043D\u044B\xBB"
      kind: 1
      minimumErudition: 0
      answer: 
    - id: level_v4_c10_t0_n05
      text: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0443\u0431\u043E\u0440\u043A\u0438
        \u043F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B
        \u0431\u0438\u043B\u0435\u0442 \u0441 \u0434\u0430\u0442\u043E\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u0420\u043E\u043C\u0430\u043D\u044B\xBB"
      kind: 1
