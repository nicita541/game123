        \u043C\u0435\u043D\u044F\u0435\u0442 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435
        \u043A\u043E \u0432\u0441\u0435\u043C\u0443 \u0434\u0435\u043B\u0443."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
