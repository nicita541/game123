      kind: 1
      minimumErudition: 0
      answer: ""
    - id: level_v2_c11_t0_n01
      text: "Девочка нашёл говорящего ворона."
      source: "Подборка «Сказки»"
      kind: 1
      minimumErudition: 0
      answer: ""
    - id: level_v2_c11_t0_n02
      text: "Путник нашёл дорогу домой."
