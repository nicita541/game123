  - id: e9044d5c0d5648ecb59f317870a4fffb
    title: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F"
    picture: {fileID: -3387787167867064973, guid: bcddea258b0195040bc422c3dd6dd81f, type: 3}
    group: 1
    phrases:
    - id: phrase_cc13c2fe53cf42cabf771ddb85604c48
      text: "\u041B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442
        \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0443 \u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: phrase_ef1203fdc281410e8ad9b5c669a79796
      text: "\u041D\u043E\u0432\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441
        \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C
        \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u043C\u0438\u0440."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: phrase_7ad485d15de947e49bb678a3d37cfebc
      text: "\u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435
        \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
        \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 0
      minimumErudition: 0
