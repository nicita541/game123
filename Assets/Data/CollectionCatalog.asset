    - id: level_v4_c07_t1_n00
      text: "\u0422\u0435\u043C\u0430 \u043E \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u043C
        \u0434\u043E\u0432\u0435\u0440\u0438\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
