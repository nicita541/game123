      minimumErudition: 0
      answer: 
    - id: level_v4_c12_t0_n01
      text: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u043A
        \u043C\u043E\u0436\u0435\u0442 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
        \u043E \u0431\u0435\u0440\u0435\u0436\u043D\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438
        \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u043B\u0438\u043D\u043D\u043E\u0439
        \u0440\u0435\u0447\u0438."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c12_t0_n02
      text: "\u041E\u0434\u0438\u043D \u0447\u0435\u0441\u0442\u043D\u044B\u0439
        \u0432\u043E\u043F\u0440\u043E\u0441 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E
        \u0432\u044B\u0432\u043E\u0434\u0438\u0442 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
        \u043A \u0442\u0435\u043C\u0435 \u043E \u043A\u0440\u0435\u043F\u043A\u043E\u043C
        \u0434\u043E\u0432\u0435\u0440\u0438\u0438."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c12_t0_n03
      text: "\u0417\u0430\u043F\u0438\u0441\u044C \u0432 \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0435
        \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043A \u0442\u0435\u043C\u0435
        \u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0435."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c12_t0_n04
      text: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043E\u0448\u0438\u0431\u043A\u0430
        \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E \u043F\u0440\u0430\u0432\u0435
        \u043D\u0430 \u043E\u0448\u0438\u0431\u043A\u0443."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c12_t0_n05
      text: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442
        \u043C\u0435\u043D\u044F\u0435\u0442 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435
        \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443 \u043E \u0442\u043E\u0447\u043D\u043E\u043C
        \u0432\u043E\u043F\u0440\u043E\u0441\u0435."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c12_t0_n06
      text: "\u0422\u0435\u043C\u0430 \u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u043C
        \u043E\u0442\u0432\u0435\u0442\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u0442\u0430\u043C, \u0433\u0434\u0435 \u0435\u0451 \u0441\u043E\u0432\u0441\u0435\u043C
        \u043D\u0435 \u0436\u0434\u0430\u043B\u0438."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c12_t0_n07
      text: "\u041F\u0430\u0443\u0437\u0430 \u0438\u043D\u043E\u0433\u0434\u0430
        \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0442\u043E\u0447\u043D\u0435\u0435
        \u043F\u043E\u043D\u044F\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
        \u043E \u043D\u043E\u0432\u043E\u043C \u043E\u043F\u044B\u0442\u0435."
      source: "\u041C\u044B\u0441\u043B\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
