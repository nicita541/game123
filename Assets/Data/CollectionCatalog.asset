    - id: level_v4_c16_t0_n07
      text: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0441\u0430\u0434\u043E\u0432\u043D\u0438\u043A
        \u043F\u0435\u0440\u0432\u044B\u043C \u0437\u0430\u043C\u0435\u0442\u0438\u043B
        \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u0443\u044E \u0441\u0432\u044F\u0437\u044C."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
        \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F\xBB"
      kind: 1
