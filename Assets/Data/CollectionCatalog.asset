      kind: 2
      minimumErudition: 0
      answer: ""
    - id: level_v2_c14_t0_n07
      text: "Забота о близких ценится делом."
      source: "Пословицы Совушки"
      kind: 2
      minimumErudition: 0
      answer: ""
    - id: level_v2_c14_t0_n08
      text: "Честный опыт ценится делом."
      source: "Пословицы Совушки"
      kind: 2
      minimumErudition: 0
      answer: ""
    - id: level_v2_c14_t0_n09
      text: "Малый шаг ценится делом."
      source: "Пословицы Совушки"
      kind: 2
      minimumErudition: 0
      answer: ""
    - id: level_v2_c14_t1_n00
      text: "Терпение крепнет там, где человек не ищет лёгких оправданий."
      source: "Пословицы Совушки"
      kind: 2
      minimumErudition: 60
      answer: ""
    - id: level_v2_c14_t1_n01
      text: "Честное слово крепнет там, где человек не ищет лёгких оправданий."
