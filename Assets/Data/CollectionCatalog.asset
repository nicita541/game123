      text: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0442\u0440\u0443\u0434 \u0437\u0430\u043C\u0435\u0442\u043D\u043E
        \u043F\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0443."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 0
      answer: 
    - id: level_v4_c14_t0_n04
      text: "\u0420\u0430\u0437\u0443\u043C\u043D\u0430\u044F \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u044C
        \u043A\u0440\u0435\u043F\u043D\u0435\u0442 \u043F\u043E\u0441\u043B\u0435
        \u0442\u0440\u0443\u0434\u043D\u043E\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 0
      answer: 
    - id: level_v4_c14_t0_n05
      text: "\u041F\u043E\u043B\u0435\u0437\u043D\u043E\u0435 \u0437\u043D\u0430\u043D\u0438\u0435
        \u0432\u0435\u0434\u0451\u0442 \u0434\u0430\u043B\u044C\u0448\u0435 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439
        \u0443\u0434\u0430\u0447\u0438."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 0
      answer: 
    - id: level_v4_c14_t0_n06
      text: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0443\u043C
        \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442\u0441\u044F \u0434\u0435\u043B\u043E\u043C."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 0
      answer: 
    - id: level_v4_c14_t0_n07
      text: "\u0417\u0430\u0431\u043E\u0442\u0430 \u043E \u0431\u043B\u0438\u0437\u043A\u0438\u0445
        \u043D\u0435 \u043B\u044E\u0431\u0438\u0442 \u043F\u0443\u0441\u0442\u044B\u0445
        \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0439."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 0
      answer: 
    - id: level_v4_c14_t0_n08
      text: "\u0427\u0435\u0441\u0442\u043D\u044B\u0439 \u043E\u043F\u044B\u0442
        \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0442\u0430\u043C, \u0433\u0434\u0435
        \u0441\u043F\u0435\u0448\u043A\u0430 \u043C\u0435\u0448\u0430\u0435\u0442."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 0
      answer: 
    - id: level_v4_c14_t0_n09
      text: "\u041C\u0430\u043B\u044B\u0439 \u0448\u0430\u0433 \u0446\u0435\u043D\u0438\u0442\u0441\u044F
        \u0431\u043E\u043B\u044C\u0448\u0435 \u0433\u0440\u043E\u043C\u043A\u0438\u0445
        \u0441\u043B\u043E\u0432."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 0
      answer: 
    - id: level_v4_c14_t1_n00
      text: "\u0422\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u0446\u0435\u043D\u0438\u0442\u0441\u044F
        \u0441\u0438\u043B\u044C\u043D\u0435\u0435, \u043A\u043E\u0433\u0434\u0430
        \u0435\u0433\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
        \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u043A, \u0430 \u043D\u0435 \u0443\u0434\u0430\u0447\u043D\u0430\u044F
        \u0440\u0435\u0447\u044C."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t1_n01
      text: "\u0427\u0435\u0441\u0442\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E
        \u043D\u0435 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0439,
        \u043D\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
        \u0438\u0445 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0438 \u0431\u0435\u0437
        \u0441\u043F\u0435\u0448\u043A\u0438."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t1_n02
      text: "\u0412\u0435\u0440\u043D\u0430\u044F \u0434\u0440\u0443\u0436\u0431\u0430
        \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u043E\u0439,
        \u0435\u0441\u043B\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C
        \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u0448\u0430\u0433
        \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u043F\u043E\u0445\u0432\u0430\u043B\u044B."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t1_n03
      text: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0442\u0440\u0443\u0434 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
        \u0432\u0430\u0436\u043D\u043E \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
        \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0438\u0434\u0438\u0442
        \u0442\u0432\u043E\u0435\u0433\u043E \u0432\u044B\u0431\u043E\u0440\u0430."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t1_n04
      text: "\u0420\u0430\u0437\u0443\u043C\u043D\u0430\u044F \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u044C
        \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C
        \u043D\u0430\u0447\u0430\u0442\u043E\u0435, \u0435\u0441\u043B\u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
        \u0443\u0436\u0435 \u043F\u0440\u043E\u0448\u043B\u043E."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t1_n05
      text: "\u041F\u043E\u043B\u0435\u0437\u043D\u043E\u0435 \u0437\u043D\u0430\u043D\u0438\u0435
        \u0440\u0430\u0441\u0442\u0451\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
        \u0437\u0430\u0442\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
        \u0434\u043E\u043B\u044C\u0448\u0435 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0433\u043E
        \u0443\u0441\u043F\u0435\u0445\u0430."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t1_n06
      text: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0443\u043C
        \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u043F\u043E\u043B\u044C\u0437\u0443
        \u0442\u043E\u043C\u0443, \u043A\u0442\u043E \u043D\u0435 \u0431\u0440\u043E\u0441\u0430\u0435\u0442
        \u0434\u0435\u043B\u043E \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0439
        \u043E\u0448\u0438\u0431\u043A\u0438."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t1_n07
      text: "\u0417\u0430\u0431\u043E\u0442\u0430 \u043E \u0431\u043B\u0438\u0437\u043A\u0438\u0445
        \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0437\u0430\u043C\u0435\u0442\u043D\u043E
        \u043D\u0435 \u0432 \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0438, \u0430
        \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A
        \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435 \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0438."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t1_n08
      text: "\u0427\u0435\u0441\u0442\u043D\u044B\u0439 \u043E\u043F\u044B\u0442
        \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
        \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435, \u043A\u043E\u0433\u0434\u0430
        \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u043F\u0443\u0442\u044C \u043A\u0430\u0436\u0435\u0442\u0441\u044F
        \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0437\u0430\u043C\u0430\u043D\u0447\u0438\u0432\u044B\u043C."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t1_n09
      text: "\u041C\u0430\u043B\u044B\u0439 \u0448\u0430\u0433 \u0440\u0435\u0434\u043A\u043E
        \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0441\u0440\u0430\u0437\u0443:
        \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u043E\u0448\u0438\u0431\u043A\u0438
        \u0438 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0441\u043D\u043E\u0432\u0430."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 60
      answer: 
    - id: level_v4_c14_t2_n00
      text: "\u0422\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u0442\u0430\u043C, \u0433\u0434\u0435 \u0443\u0434\u043E\u0431\u043D\u0435\u0435
        \u0431\u044B\u043B\u043E \u0431\u044B \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C,
        \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C \u0438\u043B\u0438
        \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 160
      answer: 
    - id: level_v4_c14_t2_n01
      text: "\u0427\u0435\u0441\u0442\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E
        \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
        \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435 \u043A \u0434\u0440\u0443\u0433\u043E\u043C\u0443
        \u0434\u0430\u0436\u0435 \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
        \u043C\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 160
      answer: 
    - id: level_v4_c14_t2_n02
      text: "\u0412\u0435\u0440\u043D\u0430\u044F \u0434\u0440\u0443\u0436\u0431\u0430
        \u0446\u0435\u043D\u0438\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
        \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C,
        \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439
        \u0443\u0441\u043F\u0435\u0445 \u0435\u0449\u0451 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442."
      source: "\u041F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u044B \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
      kind: 2
      minimumErudition: 160
      answer: 
    - id: level_v4_c14_t2_n03
      text: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0442\u0440\u0443\u0434 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
        \u0441 \u043C\u0430\u043B\u043E\u0433\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044F,
