      answer: 
    - id: level_v4_c08_t0_n02
      text: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
        \u043E \u043F\u0440\u043E\u0441\u0442\u043E\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u0438
        \u0432\u0430\u0436\u043D\u0435\u0435 \u0433\u043E\u0442\u043E\u0432\u043E\u0433\u043E
        \u0441\u043E\u0432\u0435\u0442\u0430."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041C\u0443\u0434\u0440\u043E\u0441\u0442\u044C\xBB"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c08_t0_n03
      text: "\u041C\u044B\u0441\u043B\u044C \u043E \u0433\u0440\u0430\u043D\u0438\u0446\u0430\u0445
        \u0437\u043D\u0430\u043D\u0438\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u044F\u0441\u043D\u0435\u0435 \u043F\u043E\u0441\u043B\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
        \u043F\u0430\u0443\u0437\u044B."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041C\u0443\u0434\u0440\u043E\u0441\u0442\u044C\xBB"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c08_t0_n04
      text: "\u041E \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F\u0445
        \u0432\u044B\u0431\u043E\u0440\u0430 \u0447\u0430\u0449\u0435 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
        \u043D\u0435 \u0432 \u0448\u0443\u043C\u0435, \u0430 \u0432 \u0442\u0438\u0448\u0438\u043D\u0435."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041C\u0443\u0434\u0440\u043E\u0441\u0442\u044C\xBB"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c08_t0_n05
      text: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u043A
        \u043C\u043E\u0436\u0435\u0442 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
        \u043E \u0447\u0443\u0436\u043E\u043C \u0441\u043E\u0432\u0435\u0442\u0435
        \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u043B\u0438\u043D\u043D\u043E\u0439
        \u0440\u0435\u0447\u0438."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041C\u0443\u0434\u0440\u043E\u0441\u0442\u044C\xBB"
