      text: "\u041E\u0441\u0435\u043D\u043D\u0438\u0439 \u0432\u0435\u0447\u0435\u0440
        \u0441\u043D\u043E\u0432\u0430 \u0432\u0435\u0440\u043D\u0443\u043B \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
