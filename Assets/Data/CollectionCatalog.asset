        \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0442\u0435\u0431\u044F."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u041B\u044E\u0431\u043E\u0432\u044C\xBB"
      kind: 0
