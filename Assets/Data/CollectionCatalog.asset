  cards:
  - id: legacy_0
    title: "А. С. Пушкин"
    picture: {fileID: 9007033131651448892, guid: 352a4fd5bcd85404aa9e611dbbcf9cc7, type: 3}
    group: 0
    phrases:
    - id: level_v2_c00_t0_n00
      text: "Человек думает о свободе и чести."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t0_n01
      text: "Путник думает о верной дружбе."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t0_n02
      text: "Читатель думает о осеннем саде."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t0_n03
      text: "Наблюдатель думает о морском просторе."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t0_n04
      text: "Герой думает о силе поэзии."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t0_n05
      text: "Собеседник думает о бережной любви."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t0_n06
      text: "Ученик думает о дальней дороге."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t0_n07
      text: "Мечтатель думает о памяти о встрече."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t0_n08
      text: "Исследователь думает о красоте родной речи."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t0_n09
      text: "Друг думает о надежде на счастье."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v2_c00_t1_n00
      text: "Человек размышляет о свободе и чести в тихом саду."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t1_n01
      text: "Путник размышляет о верной дружбе у окна."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t1_n02
      text: "Читатель размышляет о осеннем саде в долгой дороге."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t1_n03
      text: "Наблюдатель размышляет о морском просторе после дождя."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t1_n04
      text: "Герой размышляет о силе поэзии за вечерним столом."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t1_n05
      text: "Собеседник размышляет о бережной любви на рассвете."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t1_n06
      text: "Ученик размышляет о дальней дороге в старой комнате."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t1_n07
      text: "Мечтатель размышляет о памяти о встрече на прогулке."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t1_n08
      text: "Исследователь размышляет о красоте родной речи в тишине."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t1_n09
      text: "Друг размышляет о надежде на счастье по пути домой."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c00_t2_n00
      text: "Человек размышляет о свободе и чести, когда вечер становится тише."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t2_n01
      text: "Путник размышляет о верной дружбе, когда дорога выводит к новому месту."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t2_n02
      text: "Читатель размышляет о осеннем саде, когда дождь заканчивается."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t2_n03
      text: "Наблюдатель размышляет о морском просторе, когда разговор неожиданно меняет тон."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t2_n04
      text: "Герой размышляет о силе поэзии, когда старое воспоминание возвращается."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t2_n05
      text: "Собеседник размышляет о бережной любви, когда первый план приходится менять."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t2_n06
      text: "Ученик размышляет о дальней дороге, когда рядом появляется тот, кому нужна помощь."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t2_n07
      text: "Мечтатель размышляет о памяти о встрече, когда обычная деталь привлекает внимание."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t2_n08
      text: "Исследователь размышляет о красоте родной речи, когда время заставляет сделать выбор."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t2_n09
      text: "Друг размышляет о надежде на счастье, когда новый вопрос меняет прежний взгляд."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v2_c00_t3_n00
      text: "Человек размышляет о свободе и чести, потому что важное часто скрыто в простых вещах, и он делает следующий шаг спокойнее."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t3_n01
      text: "Путник размышляет о верной дружбе, потому что честный выбор требует спокойствия, и он меняет прежнее решение."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t3_n02
      text: "Читатель размышляет о осеннем саде, потому что внимание помогает увидеть больше, и он слушает другого внимательнее."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t3_n03
      text: "Наблюдатель размышляет о морском просторе, потому что опыт становится полезным после размышления, и он возвращается к вопросу позже."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t3_n04
      text: "Герой размышляет о силе поэзии, потому что доверие растёт из поступков, и он проверяет свой вывод ещё раз."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t3_n05
      text: "Собеседник размышляет о бережной любви, потому что ошибка может стать началом нового пути, и он выбирает честный разговор."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t3_n06
      text: "Ученик размышляет о дальней дороге, потому что память меняет значение привычных слов, и он замечает собственную ошибку."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t3_n07
      text: "Мечтатель размышляет о памяти о встрече, потому что терпение помогает закончить начатое, и он сохраняет важную мысль."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t3_n08
      text: "Исследователь размышляет о красоте родной речи, потому что добрый поступок сильнее громкого обещания, и он не спешит с ответом."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t3_n09
      text: "Друг размышляет о надежде на счастье, потому что точный вопрос полезнее поспешного ответа, и он решает действовать точнее."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v2_c00_t4_n00
      text: "Когда вечер становится тише, человек возвращается к мысли о свободе и чести; Важное часто скрыто в простых вещах, поэтому он делает следующий шаг спокойнее, чтобы не потерять главное."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v2_c00_t4_n01
      text: "Когда дорога выводит к новому месту, путник возвращается к мысли о верной дружбе; Честный выбор требует спокойствия, поэтому он меняет прежнее решение, чтобы понять ситуацию глубже."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v2_c00_t4_n02
      text: "Когда дождь заканчивается, читатель возвращается к мысли о осеннем саде; Внимание помогает увидеть больше, поэтому он слушает другого внимательнее, чтобы сохранить доверие."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v2_c00_t4_n03
      text: "Когда разговор неожиданно меняет тон, наблюдатель возвращается к мысли о морском просторе; Опыт становится полезным после размышления, поэтому он возвращается к вопросу позже, чтобы исправить ошибку вовремя."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v2_c00_t4_n04
      text: "Когда старое воспоминание возвращается, герой возвращается к мысли о силе поэзии; Доверие растёт из поступков, поэтому он проверяет свой вывод ещё раз, чтобы увидеть связь событий."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v2_c00_t4_n05
      text: "Когда первый план приходится менять, собеседник возвращается к мысли о бережной любви; Ошибка может стать началом нового пути, поэтому он выбирает честный разговор, чтобы сделать выбор осознанно."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v2_c00_t4_n06
      text: "Когда рядом появляется тот, кому нужна помощь, ученик возвращается к мысли о дальней дороге; Память меняет значение привычных слов, поэтому он замечает собственную ошибку, чтобы не пройти мимо важной детали."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v2_c00_t4_n07
      text: "Когда обычная деталь привлекает внимание, мечтатель возвращается к мысли о памяти о встрече; Терпение помогает закончить начатое, поэтому он сохраняет важную мысль, чтобы сохранить уважение к другому."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v2_c00_t4_n08
      text: "Когда время заставляет сделать выбор, исследователь возвращается к мысли о красоте родной речи; Добрый поступок сильнее громкого обещания, поэтому он не спешит с ответом, чтобы довести дело до конца."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v2_c00_t4_n09
      text: "Когда новый вопрос меняет прежний взгляд, друг возвращается к мысли о надежде на счастье; Точный вопрос полезнее поспешного ответа, поэтому он решает действовать точнее, чтобы оставить место новому опыту."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    includeLegacy: 0
    legacyGroup: 0
    legacyIndex: 0
    legacyTarget: 0
  - id: legacy_1
    title: "Л. Н. Толстой"
    picture: {fileID: -6907777403411581506, guid: 352a4fd5bcd85404aa9e611dbbcf9cc7, type: 3}
    group: 0
    phrases:
    - id: level_v2_c01_t0_n00
