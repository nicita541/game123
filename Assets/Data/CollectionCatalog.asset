      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c01_t1_n00
      text: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u0430\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430
        \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0432 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0443\u044E \u0431\u0435\u0441\u0435\u0434\u0443
        \u043E \u0441\u0435\u043C\u0435\u0439\u043D\u043E\u043C \u0434\u043E\u0432\u0435\u0440\u0438\u0438."
      source: "\u041F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
