      answer: 
    - id: level_v4_c04_t0_n09
      text: "\u0413\u0435\u0440\u043E\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
        \u043E\u0431 \u044F\u0440\u043A\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u0438
