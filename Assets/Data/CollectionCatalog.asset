  - id: legacy_5
    title: "\u0418. \u0421. \u0422\u0443\u0440\u0433\u0435\u043D\u0435\u0432"
    subtitle: "\u041F\u0440\u043E\u0437\u0430, \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B, \u043C\u044B\u0441\u043B\u0438"
    picture: {fileID: 1506964622191146232, guid: 352a4fd5bcd85404aa9e611dbbcf9cc7, type: 3}
    group: 0
    phrases:
    - id: level_v4_c05_t0_n00
      text: "\u0417\u0430 \u043E\u043A\u043D\u043E\u043C \u0442\u0435\u043C\u043D\u0435\u0435\u0442,
        \u0430 \u0431\u0435\u0441\u0435\u0434\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451
        \u0438\u0434\u0451\u0442 \u043E \u0434\u044B\u0445\u0430\u043D\u0438\u0438
        \u043B\u0435\u0441\u0430."
      source: "\u041F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
        \u0418. \u0421. \u0422\u0443\u0440\u0433\u0435\u043D\u0435\u0432\u0430"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c05_t0_n01
      text: "\u0414\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u0441\u043F\u043E\u0440
        \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u043F\u0435\u0440\u0435\u0448\u0451\u043B
        \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443 \u043E \u043F\u0435\u0440\u0432\u043E\u043C
        \u0447\u0443\u0432\u0441\u0442\u0432\u0435."
      source: "\u041F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
        \u0418. \u0421. \u0422\u0443\u0440\u0433\u0435\u043D\u0435\u0432\u0430"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c05_t0_n02
      text: "\u0422\u0438\u0445\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430
        \u0445\u0440\u0430\u043D\u0438\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439
        \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043E \u0441\u0432\u0435\u0442\u0435
        \u043F\u043E\u043B\u0435\u0439."
      source: "\u041F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
        \u0418. \u0421. \u0422\u0443\u0440\u0433\u0435\u043D\u0435\u0432\u0430"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c05_t0_n03
      text: "\u041E\u0434\u0438\u043D \u0432\u043E\u043F\u0440\u043E\u0441 \u0441\u043D\u043E\u0432\u0430
        \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
        \u043E \u0433\u043E\u043B\u043E\u0441\u0435 \u0434\u0435\u0440\u0435\u0432\u043D\u0438."
      source: "\u041F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
        \u0418. \u0421. \u0422\u0443\u0440\u0433\u0435\u043D\u0435\u0432\u0430"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c05_t0_n04
      text: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430
        \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u043C\u044B\u0441\u043B\u044C
        \u043E \u0437\u0430\u043F\u0430\u0445\u0435 \u0442\u0440\u0430\u0432\u044B."
      source: "\u041F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
        \u0418. \u0421. \u0422\u0443\u0440\u0433\u0435\u043D\u0435\u0432\u0430"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c05_t0_n05
      text: "\u0421\u0442\u0430\u0440\u0430\u044F \u0441\u0442\u0440\u043E\u043A\u0430
        \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043E \u0441\u0442\u0430\u0440\u043E\u043C
        \u0441\u0430\u0434\u0435."
      source: "\u041F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
        \u0418. \u0421. \u0422\u0443\u0440\u0433\u0435\u043D\u0435\u0432\u0430"
      kind: 0
      minimumErudition: 0
      answer: 
    - id: level_v4_c05_t0_n06
      text: "\u0412 \u043F\u0438\u0441\u044C\u043C\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0432
        \u043E \u043F\u0430\u043C\u044F\u0442\u0438 \u043E \u044E\u043D\u043E\u0441\u0442\u0438."
      source: "\u041F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
