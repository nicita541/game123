%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a5a4181e712dbe844b67f2df9cbfb3fa, type: 3}
  m_Name: CollectionCatalog
  m_EditorClassIdentifier: Assembly-CSharp::Erudition.CollectionCatalog
  cards:
  - id: legacy_0
    title: "А. С. Пушкин"
    picture: {fileID: 9007033131651448892, guid: 352a4fd5bcd85404aa9e611dbbcf9cc7, type: 3}
    group: 0
    phrases:
    - id: level_v4_c00_t0_n00
      text: "Старая строка напоминает о свободе и чести."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t0_n01
      text: "В письме осталось несколько слов о верной дружбе."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t0_n02
      text: "Осенний вечер снова вернул разговор к вопросу об осеннем саде."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t0_n03
      text: "Герой говорит о морском просторе прямо и без лишней торжественности."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t0_n04
      text: "На полях книги сохранилась короткая заметка о силе поэзии."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t0_n05
      text: "За окном темнеет, а беседа всё ещё идёт о бережной любви."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t0_n06
      text: "Дорожный спор неожиданно перешёл к разговору о дальней дороге."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t0_n07
      text: "Тихая комната хранит спокойный разговор о памяти о встрече."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t0_n08
      text: "Один вопрос снова заставил заговорить о красоте родной речи."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t0_n09
      text: "Последняя страница оставила мысль о надежде на счастье."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c00_t1_n00
      text: "После долгой паузы герой возвращается к разговору о свободе и чести, но отвечает уже иначе."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t1_n01
      text: "Случайная встреча превращается в серьёзную беседу о верной дружбе."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t1_n02
      text: "В старом письме знакомая фраза неожиданно напоминает об осеннем саде."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t1_n03
      text: "Разговор о морском просторе начинается легко, а заканчивается важным решением."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t1_n04
      text: "Герой долго молчит, прежде чем сказать несколько честных слов о силе поэзии."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t1_n05
      text: "Обычная дорога становится поводом для спокойного разговора о бережной любви."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t1_n06
      text: "Среди домашних мелочей особенно ясно вспоминают о дальней дороге."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t1_n07
      text: "Старая книга неожиданно возвращает героя к мысли о памяти о встрече."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t1_n08
      text: "Небольшой спор помогает точнее понять, что важно в разговоре о красоте родной речи."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t1_n09
      text: "Вечерняя тишина оставляет время подумать о надежде на счастье без спешки."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c00_t2_n00
      text: "Когда привычный ответ перестал казаться верным, разговор о свободе и чести перестаёт быть отвлечённым и требует ответа."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t2_n01
      text: "Тема разговора о верной дружбе возникает случайно, но к концу беседы меняет отношение героя к происходящему."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t2_n02
      text: "Воспоминание об осеннем саде приходит именно в тот момент, когда прежнее решение начинает казаться сомнительным."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t2_n03
      text: "Герой хотел избежать разговора о морском просторе, однако одна простая деталь заставила его остаться."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t2_n04
      text: "Письмо о силе поэзии сначала кажется незначительным, но затем связывает несколько давних событий."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t2_n05
      text: "Разговор о бережной любви проходит через спор, паузу и неожиданное признание."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t2_n06
      text: "Во время дороги мысль о дальней дороге возвращается несколько раз и постепенно становится яснее."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t2_n07
      text: "Слова о памяти о встрече звучат спокойно, хотя за ними скрывается непростой выбор."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t2_n08
      text: "Встреча начинается с пустяка, а заканчивается серьёзным разговором о красоте родной речи."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t2_n09
      text: "История о надежде на счастье меняет смысл после того, как становится известна одна забытая подробность."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c00_t3_n00
      text: "Когда привычный ответ перестал казаться верным, герой вспоминает о свободе и чести; и решение стало спокойнее."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t3_n01
      text: "Разговор о верной дружбе становится труднее после новой детали, но именно она помогает отделить привычку от настоящего убеждения."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t3_n02
      text: "Память об осеннем саде сталкивается с сегодняшним выбором, и герой впервые замечает противоречие в собственных словах."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t3_n03
      text: "Тема о морском просторе проходит через весь вечер: сначала как шутка, затем как спор и наконец как решение."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t3_n04
      text: "Старая запись о силе поэзии неожиданно объясняет поступок, который раньше казался бессмысленным."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t3_n05
      text: "Герой пытается говорить о бережной любви спокойно, хотя каждый новый факт заставляет пересматривать прежнюю уверенность."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t3_n06
      text: "Дорога даёт время вернуться к мысли о дальней дороге, сравнить прошлое с настоящим и отказаться от поспешного вывода."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t3_n07
      text: "Разговор о памяти о встрече не приводит к мгновенному согласию, зато помогает каждому точнее понять свою позицию."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t3_n08
      text: "Воспоминание о красоте родной речи становится ключом к сцене, где важнее всего оказывается не речь, а поступок."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t3_n09
      text: "Последняя фраза о надежде на счастье звучит просто, но после неё весь предыдущий разговор воспринимается иначе."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c00_t4_n00
      text: "После того как привычный ответ перестал казаться верным, герой возвращается к теме о свободе и чести; он сравнивает прошлые обещания с нынешними поступками, замечает собственную ошибку и решение стало спокойнее."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c00_t4_n01
      text: "Разговор о верной дружбе начинается с бытовой мелочи, затем затрагивает старое воспоминание и приводит к выбору, который уже нельзя объяснить одной случайностью."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c00_t4_n02
      text: "Письмо об осеннем саде читают дважды: сначала как обычную новость, а потом как свидетельство того, что давняя история всё ещё влияет на настоящее."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c00_t4_n03
      text: "Герой избегал темы о морском просторе, пока новый факт не заставил его соединить несколько разрозненных событий и признать, что прежний вывод был слишком простым."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c00_t4_n04
      text: "Спор о силе поэзии постепенно теряет резкость: собеседники перестают защищать готовые ответы, проверяют факты и замечают, что настоящая причина конфликта лежит глубже."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c00_t4_n05
      text: "Долгая дорога возвращает к мысли о бережной любви; знакомые места вызывают разные воспоминания, и каждый из них по-своему меняет окончательное решение."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c00_t4_n06
      text: "Слова о дальней дороге сначала звучат как общая фраза, но конкретный поступок придаёт им вес и заставляет героя отвечать не за намерения, а за последствия."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c00_t4_n07
      text: "Вечерний разговор о памяти о встрече несколько раз меняет направление, потому что новые подробности противоречат прежним версиям и требуют более честного взгляда на себя."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c00_t4_n08
      text: "Воспоминание о красоте родной речи связывает прошлое и настоящее: то, что когда-то казалось мелочью, теперь помогает понять мотив другого человека и отказаться от поспешного обвинения."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c00_t4_n09
      text: "Финальная мысль о надежде на счастье появляется не сразу: к ней ведут спор, ошибка, неожиданное признание и решение проверить собственные слова поступком."
      source: "По мотивам творчества А. С. Пушкина"
      kind: 0
      minimumErudition: 560
      answer: ""
    includeLegacy: 0
    legacyGroup: 0
    legacyIndex: 0
    legacyTarget: 0
    cachedEntryStart: 0
    cachedEntryCount: 50
    cachedTarget: 50
  - id: legacy_1
    title: "Л. Н. Толстой"
    picture: {fileID: -6907777403411581506, guid: 352a4fd5bcd85404aa9e611dbbcf9cc7, type: 3}
    group: 0
    phrases:
    - id: level_v4_c01_t0_n00
      text: "В письме осталось несколько слов о семейном доверии."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t0_n01
      text: "Осенний вечер снова вернул разговор к вопросу о голосе совести."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t0_n02
      text: "Герой говорит о честном труде прямо и без лишней торжественности."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t0_n03
      text: "На полях книги сохранилась короткая заметка о живом участии."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t0_n04
      text: "За окном темнеет, а беседа всё ещё идёт о цене правды."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t0_n05
      text: "Дорожный спор неожиданно перешёл к разговору о мирном выборе."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t0_n06
      text: "Тихая комната хранит спокойный разговор о личном долге."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t0_n07
      text: "Один вопрос снова заставил заговорить о простой жизни."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t0_n08
      text: "Последняя страница оставила мысль о силе прощения."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t0_n09
      text: "Старая строка напоминает об уважении к людям."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c01_t1_n00
      text: "Случайная встреча превращается в серьёзную беседу о семейном доверии."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t1_n01
      text: "В старом письме знакомая фраза неожиданно напоминает о голосе совести."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t1_n02
      text: "Разговор о честном труде начинается легко, а заканчивается важным решением."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t1_n03
      text: "Герой долго молчит, прежде чем сказать несколько честных слов о живом участии."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t1_n04
      text: "Обычная дорога становится поводом для спокойного разговора о цене правды."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t1_n05
      text: "Среди домашних мелочей особенно ясно вспоминают о мирном выборе."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t1_n06
      text: "Старая книга неожиданно возвращает героя к мысли о личном долге."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t1_n07
      text: "Небольшой спор помогает точнее понять, что важно в разговоре о простой жизни."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t1_n08
      text: "Вечерняя тишина оставляет время подумать о силе прощения без спешки."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t1_n09
      text: "После долгой паузы герой возвращается к разговору об уважении к людям, но отвечает уже иначе."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c01_t2_n00
      text: "Тема разговора о семейном доверии возникает случайно, но к концу беседы меняет отношение героя к происходящему."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t2_n01
      text: "Воспоминание о голосе совести приходит именно в тот момент, когда прежнее решение начинает казаться сомнительным."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t2_n02
      text: "Герой хотел избежать разговора о честном труде, однако одна простая деталь заставила его остаться."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t2_n03
      text: "Письмо о живом участии сначала кажется незначительным, но затем связывает несколько давних событий."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t2_n04
      text: "Разговор о цене правды проходит через спор, паузу и неожиданное признание."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t2_n05
      text: "Во время дороги мысль о мирном выборе возвращается несколько раз и постепенно становится яснее."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t2_n06
      text: "Слова о личном долге звучат спокойно, хотя за ними скрывается непростой выбор."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t2_n07
      text: "Встреча начинается с пустяка, а заканчивается серьёзным разговором о простой жизни."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t2_n08
      text: "История о силе прощения меняет смысл после того, как становится известна одна забытая подробность."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t2_n09
      text: "Когда привычный ответ перестал казаться верным, разговор об уважении к людям перестаёт быть отвлечённым и требует ответа."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c01_t3_n00
      text: "Разговор о семейном доверии становится труднее после новой детали, но именно она помогает отделить привычку от настоящего убеждения."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t3_n01
      text: "Память о голосе совести сталкивается с сегодняшним выбором, и герой впервые замечает противоречие в собственных словах."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t3_n02
      text: "Тема о честном труде проходит через весь вечер: сначала как шутка, затем как спор и наконец как решение."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t3_n03
      text: "Старая запись о живом участии неожиданно объясняет поступок, который раньше казался бессмысленным."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t3_n04
      text: "Герой пытается говорить о цене правды спокойно, хотя каждый новый факт заставляет пересматривать прежнюю уверенность."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t3_n05
      text: "Дорога даёт время вернуться к мысли о мирном выборе, сравнить прошлое с настоящим и отказаться от поспешного вывода."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t3_n06
      text: "Разговор о личном долге не приводит к мгновенному согласию, зато помогает каждому точнее понять свою позицию."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t3_n07
      text: "Воспоминание о простой жизни становится ключом к сцене, где важнее всего оказывается не речь, а поступок."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t3_n08
      text: "Последняя фраза о силе прощения звучит просто, но после неё весь предыдущий разговор воспринимается иначе."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t3_n09
      text: "Когда привычный ответ перестал казаться верным, герой вспоминает об уважении к людям; и решение стало спокойнее."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c01_t4_n00
      text: "Разговор о семейном доверии начинается с бытовой мелочи, затем затрагивает старое воспоминание и приводит к выбору, который уже нельзя объяснить одной случайностью."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c01_t4_n01
      text: "Письмо о голосе совести читают дважды: сначала как обычную новость, а потом как свидетельство того, что давняя история всё ещё влияет на настоящее."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c01_t4_n02
      text: "Герой избегал темы о честном труде, пока новый факт не заставил его соединить несколько разрозненных событий и признать, что прежний вывод был слишком простым."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c01_t4_n03
      text: "Спор о живом участии постепенно теряет резкость: собеседники перестают защищать готовые ответы, проверяют факты и замечают, что настоящая причина конфликта лежит глубже."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c01_t4_n04
      text: "Долгая дорога возвращает к мысли о цене правды; знакомые места вызывают разные воспоминания, и каждый из них по-своему меняет окончательное решение."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c01_t4_n05
      text: "Слова о мирном выборе сначала звучат как общая фраза, но конкретный поступок придаёт им вес и заставляет героя отвечать не за намерения, а за последствия."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c01_t4_n06
      text: "Вечерний разговор о личном долге несколько раз меняет направление, потому что новые подробности противоречат прежним версиям и требуют более честного взгляда на себя."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c01_t4_n07
      text: "Воспоминание о простой жизни связывает прошлое и настоящее: то, что когда-то казалось мелочью, теперь помогает понять мотив другого человека и отказаться от поспешного обвинения."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c01_t4_n08
      text: "Финальная мысль о силе прощения появляется не сразу: к ней ведут спор, ошибка, неожиданное признание и решение проверить собственные слова поступком."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c01_t4_n09
      text: "После того как привычный ответ перестал казаться верным, герой возвращается к теме об уважении к людям; он сравнивает прошлые обещания с нынешними поступками, замечает собственную ошибку и решение стало спокойнее."
      source: "По мотивам творчества Л. Н. Толстого"
      kind: 0
      minimumErudition: 560
      answer: ""
    includeLegacy: 0
    legacyGroup: 0
    legacyIndex: 0
    legacyTarget: 0
    cachedEntryStart: 50
    cachedEntryCount: 50
    cachedTarget: 50
  - id: legacy_2
    title: "Ф. М. Достоевский"
    picture: {fileID: 3968046763224376387, guid: 352a4fd5bcd85404aa9e611dbbcf9cc7, type: 3}
    group: 0
    phrases:
    - id: level_v4_c02_t0_n00
      text: "Осенний вечер снова вернул разговор к вопросу о тяжести вины."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t0_n01
      text: "Герой говорит о пути к раскаянию прямо и без лишней торжественности."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t0_n02
      text: "На полях книги сохранилась короткая заметка о цене участия."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t0_n03
      text: "За окном темнеет, а беседа всё ещё идёт о страхе перед правдой."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t0_n04
      text: "Дорожный спор неожиданно перешёл к разговору об упрямой надежде."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t0_n05
      text: "Тихая комната хранит спокойный разговор о свободе выбора."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t0_n06
      text: "Один вопрос снова заставил заговорить о чужой беде."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t0_n07
      text: "Последняя страница оставила мысль об опасной гордости."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t0_n08
      text: "Старая строка напоминает о трудном прощении."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t0_n09
      text: "В письме осталось несколько слов о внутреннем споре."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c02_t1_n00
      text: "В старом письме знакомая фраза неожиданно напоминает о тяжести вины."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t1_n01
      text: "Разговор о пути к раскаянию начинается легко, а заканчивается важным решением."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t1_n02
      text: "Герой долго молчит, прежде чем сказать несколько честных слов о цене участия."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t1_n03
      text: "Обычная дорога становится поводом для спокойного разговора о страхе перед правдой."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t1_n04
      text: "Среди домашних мелочей особенно ясно вспоминают об упрямой надежде."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t1_n05
      text: "Старая книга неожиданно возвращает героя к мысли о свободе выбора."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t1_n06
      text: "Небольшой спор помогает точнее понять, что важно в разговоре о чужой беде."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t1_n07
      text: "Вечерняя тишина оставляет время подумать об опасной гордости без спешки."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t1_n08
      text: "После долгой паузы герой возвращается к разговору о трудном прощении, но отвечает уже иначе."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t1_n09
      text: "Случайная встреча превращается в серьёзную беседу о внутреннем споре."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c02_t2_n00
      text: "Воспоминание о тяжести вины приходит именно в тот момент, когда прежнее решение начинает казаться сомнительным."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t2_n01
      text: "Герой хотел избежать разговора о пути к раскаянию, однако одна простая деталь заставила его остаться."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t2_n02
      text: "Письмо о цене участия сначала кажется незначительным, но затем связывает несколько давних событий."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t2_n03
      text: "Разговор о страхе перед правдой проходит через спор, паузу и неожиданное признание."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t2_n04
      text: "Во время дороги мысль об упрямой надежде возвращается несколько раз и постепенно становится яснее."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t2_n05
      text: "Слова о свободе выбора звучат спокойно, хотя за ними скрывается непростой выбор."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t2_n06
      text: "Встреча начинается с пустяка, а заканчивается серьёзным разговором о чужой беде."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t2_n07
      text: "История об опасной гордости меняет смысл после того, как становится известна одна забытая подробность."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t2_n08
      text: "Когда привычный ответ перестал казаться верным, разговор о трудном прощении перестаёт быть отвлечённым и требует ответа."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t2_n09
      text: "Тема разговора о внутреннем споре возникает случайно, но к концу беседы меняет отношение героя к происходящему."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c02_t3_n00
      text: "Память о тяжести вины сталкивается с сегодняшним выбором, и герой впервые замечает противоречие в собственных словах."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t3_n01
      text: "Тема о пути к раскаянию проходит через весь вечер: сначала как шутка, затем как спор и наконец как решение."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t3_n02
      text: "Старая запись о цене участия неожиданно объясняет поступок, который раньше казался бессмысленным."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t3_n03
      text: "Герой пытается говорить о страхе перед правдой спокойно, хотя каждый новый факт заставляет пересматривать прежнюю уверенность."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t3_n04
      text: "Дорога даёт время вернуться к мысли об упрямой надежде, сравнить прошлое с настоящим и отказаться от поспешного вывода."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t3_n05
      text: "Разговор о свободе выбора не приводит к мгновенному согласию, зато помогает каждому точнее понять свою позицию."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t3_n06
      text: "Воспоминание о чужой беде становится ключом к сцене, где важнее всего оказывается не речь, а поступок."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t3_n07
      text: "Последняя фраза об опасной гордости звучит просто, но после неё весь предыдущий разговор воспринимается иначе."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t3_n08
      text: "Когда привычный ответ перестал казаться верным, герой вспоминает о трудном прощении; и решение стало спокойнее."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t3_n09
      text: "Разговор о внутреннем споре становится труднее после новой детали, но именно она помогает отделить привычку от настоящего убеждения."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c02_t4_n00
      text: "Письмо о тяжести вины читают дважды: сначала как обычную новость, а потом как свидетельство того, что давняя история всё ещё влияет на настоящее."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c02_t4_n01
      text: "Герой избегал темы о пути к раскаянию, пока новый факт не заставил его соединить несколько разрозненных событий и признать, что прежний вывод был слишком простым."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c02_t4_n02
      text: "Спор о цене участия постепенно теряет резкость: собеседники перестают защищать готовые ответы, проверяют факты и замечают, что настоящая причина конфликта лежит глубже."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c02_t4_n03
      text: "Долгая дорога возвращает к мысли о страхе перед правдой; знакомые места вызывают разные воспоминания, и каждый из них по-своему меняет окончательное решение."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c02_t4_n04
      text: "Слова об упрямой надежде сначала звучат как общая фраза, но конкретный поступок придаёт им вес и заставляет героя отвечать не за намерения, а за последствия."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c02_t4_n05
      text: "Вечерний разговор о свободе выбора несколько раз меняет направление, потому что новые подробности противоречат прежним версиям и требуют более честного взгляда на себя."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c02_t4_n06
      text: "Воспоминание о чужой беде связывает прошлое и настоящее: то, что когда-то казалось мелочью, теперь помогает понять мотив другого человека и отказаться от поспешного обвинения."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c02_t4_n07
      text: "Финальная мысль об опасной гордости появляется не сразу: к ней ведут спор, ошибка, неожиданное признание и решение проверить собственные слова поступком."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c02_t4_n08
      text: "После того как привычный ответ перестал казаться верным, герой возвращается к теме о трудном прощении; он сравнивает прошлые обещания с нынешними поступками, замечает собственную ошибку и решение стало спокойнее."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    - id: level_v4_c02_t4_n09
      text: "Разговор о внутреннем споре начинается с бытовой мелочи, затем затрагивает старое воспоминание и приводит к выбору, который уже нельзя объяснить одной случайностью."
      source: "По мотивам творчества Ф. М. Достоевского"
      kind: 0
      minimumErudition: 560
      answer: ""
    includeLegacy: 0
    legacyGroup: 0
    legacyIndex: 0
    legacyTarget: 0
    cachedEntryStart: 100
    cachedEntryCount: 50
    cachedTarget: 50
  - id: legacy_3
    title: "А. П. Чехов"
    picture: {fileID: 4028803010496088073, guid: 352a4fd5bcd85404aa9e611dbbcf9cc7, type: 3}
    group: 0
    phrases:
    - id: level_v4_c03_t0_n00
      text: "Герой говорит о цене простоты прямо и без лишней торжественности."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t0_n01
      text: "На полях книги сохранилась короткая заметка о точной речи."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t0_n02
      text: "За окном темнеет, а беседа всё ещё идёт об обычной доброте."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t0_n03
      text: "Дорожный спор неожиданно перешёл к разговору о честном труде."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t0_n04
      text: "Тихая комната хранит спокойный разговор о смешной гордости."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t0_n05
      text: "Один вопрос снова заставил заговорить о тихой грусти."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t0_n06
      text: "Последняя страница оставила мысль о внимании к мелочам."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t0_n07
      text: "Старая строка напоминает о правде о себе."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t0_n08
      text: "В письме осталось несколько слов о бережном юморе."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t0_n09
      text: "Осенний вечер снова вернул разговор к вопросу о чужом времени."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 0
      answer: ""
    - id: level_v4_c03_t1_n00
      text: "Разговор о цене простоты начинается легко, а заканчивается важным решением."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t1_n01
      text: "Герой долго молчит, прежде чем сказать несколько честных слов о точной речи."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t1_n02
      text: "Обычная дорога становится поводом для спокойного разговора об обычной доброте."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t1_n03
      text: "Среди домашних мелочей особенно ясно вспоминают о честном труде."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t1_n04
      text: "Старая книга неожиданно возвращает героя к мысли о смешной гордости."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t1_n05
      text: "Небольшой спор помогает точнее понять, что важно в разговоре о тихой грусти."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t1_n06
      text: "Вечерняя тишина оставляет время подумать о внимании к мелочам без спешки."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t1_n07
      text: "После долгой паузы герой возвращается к разговору о правде о себе, но отвечает уже иначе."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t1_n08
      text: "Случайная встреча превращается в серьёзную беседу о бережном юморе."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t1_n09
      text: "В старом письме знакомая фраза неожиданно напоминает о чужом времени."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v4_c03_t2_n00
      text: "Герой хотел избежать разговора о цене простоты, однако одна простая деталь заставила его остаться."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t2_n01
      text: "Письмо о точной речи сначала кажется незначительным, но затем связывает несколько давних событий."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t2_n02
      text: "Разговор об обычной доброте проходит через спор, паузу и неожиданное признание."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t2_n03
      text: "Во время дороги мысль о честном труде возвращается несколько раз и постепенно становится яснее."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t2_n04
      text: "Слова о смешной гордости звучат спокойно, хотя за ними скрывается непростой выбор."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t2_n05
      text: "Встреча начинается с пустяка, а заканчивается серьёзным разговором о тихой грусти."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t2_n06
      text: "История о внимании к мелочам меняет смысл после того, как становится известна одна забытая подробность."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t2_n07
      text: "Когда привычный ответ перестал казаться верным, разговор о правде о себе перестаёт быть отвлечённым и требует ответа."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t2_n08
      text: "Тема разговора о бережном юморе возникает случайно, но к концу беседы меняет отношение героя к происходящему."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t2_n09
      text: "Воспоминание о чужом времени приходит именно в тот момент, когда прежнее решение начинает казаться сомнительным."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 160
      answer: ""
    - id: level_v4_c03_t3_n00
      text: "Тема о цене простоты проходит через весь вечер: сначала как шутка, затем как спор и наконец как решение."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c03_t3_n01
      text: "Старая запись о точной речи неожиданно объясняет поступок, который раньше казался бессмысленным."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 320
      answer: ""
    - id: level_v4_c03_t3_n02
      text: "Герой пытается говорить об обычной доброте спокойно, хотя каждый новый факт заставляет пересматривать прежнюю уверенность."
      source: "По мотивам творчества А. П. Чехова"
      kind: 0
      minimumErudition: 320
      answer: ""
