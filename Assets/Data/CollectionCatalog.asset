        \u0443\u0447\u0435\u043D\u0438\u043A \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B
        \u0437\u0430\u043A\u043E\u043B\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u0439
        \u0441\u0430\u0434."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u0421\u043A\u0430\u0437\u043A\u0438\xBB"
      kind: 1
      minimumErudition: 0
      answer: 
    - id: level_v4_c11_t0_n07
      text: "\u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B,
        \u0447\u0442\u043E \u043E\u0445\u043E\u0442\u043D\u0438\u043A \u043D\u0430\u0439\u0434\u0451\u0442
        \u0447\u0435\u0441\u0442\u043D\u0443\u044E \u043D\u0430\u0433\u0440\u0430\u0434\u0443."
      source: "\u041F\u043E\u0434\u0431\u043E\u0440\u043A\u0430 \xAB\u0421\u043A\u0430\u0437\u043A\u0438\xBB"
      kind: 1
      minimumErudition: 0
      answer: 
    - id: level_v4_c11_t0_n08
      text: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
        \u0441 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u043F\u0430\u0441\u0442\u0443\u0445
