    - id: level_v4_c11_t0_n05
      text: "\u0412 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u0434\u043E\u043C\u0435
        \u043F\u0435\u043A\u0430\u0440\u044C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F,
