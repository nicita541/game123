      kind: 2
      minimumErudition: 0
      answer: ""
    - id: level_v2_c14_t0_n02
      text: "Верная дружба ценится делом."
      source: "Пословицы Совушки"
      kind: 2
      minimumErudition: 0
      answer: ""
    - id: level_v2_c14_t0_n03
