      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c09_t1_n01
      text: "Путник размышляет о ярком образе у окна."
      source: "Подборка «Поэзия»"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c09_t1_n02
      text: "Читатель размышляет о звуке строки в долгой дороге."
      source: "Подборка «Поэзия»"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c09_t1_n03
      text: "Наблюдатель размышляет о смысле паузы после дождя."
      source: "Подборка «Поэзия»"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c09_t1_n04
      text: "Герой размышляет о живой рифме за вечерним столом."
