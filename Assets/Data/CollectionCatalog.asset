      answer: ""
    - id: level_v2_c09_t1_n05
      text: "Собеседник размышляет о дыхании пейзажа на рассвете."
      source: "Подборка «Поэзия»"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c09_t1_n06
      text: "Ученик размышляет о голосе чувства в старой комнате."
      source: "Подборка «Поэзия»"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c09_t1_n07
      text: "Мечтатель размышляет о музыке речи на прогулке."
      source: "Подборка «Поэзия»"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c09_t1_n08
      text: "Исследователь размышляет о свете метафоры в тишине."
      source: "Подборка «Поэзия»"
      kind: 0
      minimumErudition: 60
      answer: ""
    - id: level_v2_c09_t1_n09
      text: "Друг размышляет о памяти мгновения по пути домой."
      source: "Подборка «Поэзия»"
      kind: 0
      minimumErudition: 60
