      minimumErudition: 60
      answer: "\u041A\u043D\u0438\u0433\u0430"
    - id: level_v4_c15_t1_n02
      text: "\u0420\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
        \u043D\u0435\u0431\u043E \u043F\u043B\u0430\u0447\u0435\u0442, \u0430 \u0435\u0449\u0451
        \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
        \u0438 \u043D\u0435 \u043B\u044E\u0431\u0438\u0442 \u0441\u0438\u043B\u044C\u043D\u044B\u0439
        \u0432\u0435\u0442\u0435\u0440. \u0427\u0442\u043E \u0441\u043A\u0440\u044B\u0442\u043E
        \u0432 \u0437\u0430\u0433\u0430\u0434\u043A\u0435?"
      source: "\u0417\u0430\u0433\u0430\u0434\u043A\u0438 \u0421\u043E\u0432\u0443\u0448\u043A\u0438"
