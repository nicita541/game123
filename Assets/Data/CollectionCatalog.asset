    - id: level_v4_c15_t0_n00
      text: "\u0418\u0434\u0451\u0442 \u0440\u044F\u0434\u043E\u043C, \u0445\u043E\u0442\u044F
        \u043D\u043E\u0433 \u0443 \u043D\u0435\u0451 \u043D\u0435\u0442. \u041D\u0430\u0439\u0434\u0438
        \u0440\u0430\u0437\u0433\u0430\u0434\u043A\u0443?"
