# Unity-generated directories. Build is anchored so Tools/Build stays visible.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
/[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Android/Gradle and native compilation caches (including validation projects).
.utmp/
.gradle/
.cxx/
GradleCache/

# Exported Android packages and local signing keys.
*.apk
*.aab
*.keystore
*.jks

# Python bytecode generated by the font tools.
__pycache__/
*.pyc
*.pyo

# IDE-generated files.
.vs/
.idea/
*.csproj
*.sln
*.slnx
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
